<%= form_with model: nisab_rate, local: true, class: "space-y-6" do |f| %>
  <% if nisab_rate.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md p-4" role="alert" aria-live="assertive">
      <div class="flex">
        <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
        </svg>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">Please correct the following errors:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5">
            <% nisab_rate.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :year, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :year, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm", min: 1401, max: Date.current.year + 1, required: true %>
    </div>

    <div>
      <%= f.label :gold_price_per_gram, "Gold Price (৳/gram)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :gold_price_per_gram, step: 0.01, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm", required: true %>
    </div>

    <div>
      <%= f.label :silver_price_per_gram, "Silver Price (৳/gram)", class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :silver_price_per_gram, step: 0.01, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm", required: true %>
    </div>
  </div>

  <div class="mt-4 flex gap-3">
    <%= f.submit nisab_rate.persisted? ? "Update Rate" : "Create Rate", class: "px-6 py-3 btn-primary text-white font-semibold rounded-lg shadow hover:shadow-lg bg-foundationprimarygreen" %>
    <%= link_to "Cancel", nisab_rates_path, class: "px-6 py-3 bg-gray-100 text-gray-700 rounded-lg border hover:bg-forange hover:text-white transition-colors" %>
  </div>
<% end %>
