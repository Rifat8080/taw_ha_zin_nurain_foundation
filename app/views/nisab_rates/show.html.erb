<% content_for :title, "Nisab Rate - #{ @nisab_rate.year }" %>
<div class="container mx-auto px-8 py-8">
  <div class="bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-3xl font-bold text-foundationprimarygreen"><%= @nisab_rate.year %> Nisab Rate</h1>
        <p class="mt-2 text-sm text-gray-600">Reference prices and computed nisab thresholds for the year.</p>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to edit_nisab_rate_path(@nisab_rate), class: "px-4 py-2 bg-white border rounded hover:bg-forange/10" do %>
          Edit
        <% end %>
        <%= link_to nisab_rates_path, class: "px-4 py-2 bg-gray-100 rounded hover:bg-forange/10" do %>
          Back
        <% end %>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-blue-900 mb-3">Prices</h3>
        <p class="text-sm text-blue-700">Gold price</p>
        <p class="text-blue-900 font-medium">৳<%= number_with_delimiter(@nisab_rate.gold_price_per_gram) %>/gram</p>

        <div class="mt-4">
          <p class="text-sm text-blue-700">Silver price</p>
          <p class="text-blue-900 font-medium">৳<%= number_with_delimiter(@nisab_rate.silver_price_per_gram) %>/gram</p>
        </div>
      </div>

      <div class="bg-green-50 border border-green-200 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-green-900 mb-3">Computed Nisab</h3>
        <div class="text-sm text-green-700">Gold Nisab (85g)</div>
        <div class="text-green-900 font-medium mt-1"><%= @nisab_rate.formatted_nisab_gold %></div>

        <div class="mt-4 text-sm text-green-700">Silver Nisab (595g)</div>
        <div class="text-green-900 font-medium mt-1"><%= @nisab_rate.formatted_nisab_silver %></div>

        <div class="mt-4 p-3 bg-green-100 rounded">
          <strong>Minimum Nisab Threshold:</strong>
          <div class="text-green-900 font-semibold mt-1"><%= @nisab_rate.formatted_min_nisab %></div>
        </div>
      </div>
    </div>
  </div>
</div>
