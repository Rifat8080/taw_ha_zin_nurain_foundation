<div class="max-w-3xl mx-auto px-4 py-6 sm:py-12">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-xl sm:text-2xl font-extrabold"><span class="text-foundationprimarygreen">Assignment</span> <span class="text-forange">Details</span></h1>
      <p class="mt-1 text-sm text-foundationprimarygreen">Overview of this team assignment.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
      <%= link_to 'All Assignments', team_assignments_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-forange/10 w-full sm:w-auto justify-center' %>
      <%= link_to 'All Teams', volunteers_teams_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-forange/10 w-full sm:w-auto justify-center' %>
    </div>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-6 md:flex md:items-start md:space-x-6">
      <div class="flex-1">
        <h2 class="text-lg font-semibold text-gray-900">Assignment</h2>
        <p class="mt-2 text-sm text-gray-600">Details for this assignment record.</p>

        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Volunteer</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @team_assignment.respond_to?(:volunteer) && @team_assignment.volunteer.present? ? @team_assignment.volunteer.full_name : (@team_assignment.volunteer_id || '—') %></p>
          </div>

          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Team</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @team_assignment.respond_to?(:volunteers_team) && @team_assignment.volunteers_team.present? ? @team_assignment.volunteers_team.name : (@team_assignment.team_id || '—') %></p>
          </div>

          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Assigned on</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @team_assignment.created_at ? @team_assignment.created_at.strftime('%B %d, %Y') : '—' %></p>
          </div>

          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Last updated</h3>
            <p class="mt-1 text-sm text-gray-900"><%= @team_assignment.updated_at ? @team_assignment.updated_at.strftime('%B %d, %Y') : '—' %></p>
          </div>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 flex flex-col sm:flex-row sm:justify-end gap-3">
  <%= link_to 'Edit', "#{team_assignments_path}/#{@team_assignment.id}/edit", class: 'inline-flex items-center px-4 py-2 rounded-md bg-gradient-to-r from-foundationprimarygreen to-forange text-white font-semibold w-full sm:w-auto justify-center' %>
      <%= link_to 'Back', team_assignments_path, class: 'inline-flex items-center px-4 py-2 rounded-md bg-white border border-gray-200 text-gray-700 w-full sm:w-auto justify-center' %>
  <%= button_to 'Remove', @team_assignment, method: :delete, data: { confirm: 'Remove this assignment?' }, form: { class: 'w-full sm:w-auto' }, class: 'inline-flex items-center px-4 py-2 rounded-md bg-red-600 hover:bg-red-700 text-white font-semibold w-full sm:w-auto justify-center' %>
    </div>
  </div>
</div>
