<div class="max-w-6xl mx-auto px-4 py-6 sm:py-12">
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold">Team Assignments</h1>
      <p class="mt-1 text-sm text-gray-500">Manage volunteer assignments across teams.</p>
    </div>
    <div class="flex gap-2 w-full sm:w-auto">
      <%= link_to 'New Assignment', new_team_assignment_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-gradient-to-r from-foundationprimarygreen to-forange text-white font-semibold w-full sm:w-auto justify-center' %>
      <%= link_to 'All Volunteers', volunteers_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 w-full sm:w-auto justify-center' %>
      <%= link_to 'All Teams', volunteers_teams_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 w-full sm:w-auto justify-center' %>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
    <div class="sm:col-span-2">
      <%= form_with url: team_assignments_path, method: :get, local: true, class: 'flex flex-col sm:flex-row gap-3 items-stretch sm:items-center' do |form| %>
        <%= form.select :volunteer_id, options_from_collection_for_select(Volunteer.includes(:user), :id, :full_name, params[:volunteer_id]), { prompt: 'Filter by Volunteer' }, { class: 'border border-gray-300 rounded px-3 py-2 w-full sm:w-1/2' } %>
        <%= form.select :team_id, options_from_collection_for_select(VolunteersTeam.all, :id, :name, params[:team_id]), { prompt: 'Filter by Team' }, { class: 'border border-gray-300 rounded px-3 py-2 w-full sm:w-1/3' } %>
        <div class="flex gap-2">
          <%= form.submit 'Filter', class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700' %>
          <% if params[:volunteer_id].present? || params[:team_id].present? %>
            <%= link_to 'Clear Filters', team_assignments_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-red-400 text-white' %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="text-sm text-gray-600 text-right">Total: <%= @team_assignments.count %> assignments</div>
  </div>

  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="p-4">
      <ul class="space-y-3">
        <% @team_assignments.each do |assignment| %>
          <li class="bg-white border border-gray-100 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
              <div class="text-sm font-semibold text-gray-900">
                <%= link_to assignment.volunteer_name, assignment.volunteer, class: 'text-foundationprimarygreen hover:underline' %>
              </div>
              <div class="text-sm text-gray-700"><%= assignment.volunteer.email %></div>
              <div class="mt-2 text-sm text-gray-900"><strong class="text-forange"><%= assignment.team_name %></strong> • <%= assignment.team_district %></div>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to 'View', assignment, class: 'inline-flex items-center px-3 py-1 rounded-md bg-white border border-gray-200 text-gray-700 text-xs' %>
              <% if current_user&.role == 'admin' %>
                <%= link_to 'Edit', edit_team_assignment_path(assignment), class: 'btn-primary inline-flex items-center px-3 py-1 rounded-md bg-gradient-to-r from-foundationprimarygreen to-forange text-white text-xs' %>
              <% end %>
              <%= button_to 'Remove', assignment, method: :delete, data: { confirm: 'Are you sure you want to remove this assignment?' }, form: { class: 'inline-block' }, class: 'inline-flex items-center px-3 py-1 rounded-md bg-red-500 hover:bg-red-700 text-white text-xs' %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <% if @team_assignments.empty? %>
    <div class="text-center py-8">
      <p class="text-gray-500 mb-4">No team assignments found.</p>
      <%= link_to 'Create First Assignment', new_team_assignment_path, class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
    </div>
  <% end %>
</div>
