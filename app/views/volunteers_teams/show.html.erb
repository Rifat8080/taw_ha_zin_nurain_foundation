<div class="container mx-auto px-4 py-8 max-w-7xl">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
    <% name = @volunteers_team.name.to_s %>
    <% mid = (name.length / 2.0).ceil %>
    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
      <span class="text-foundationprimarygreen"><%= h name[0, mid] %></span><span class="text-forange"><%= h name[mid..-1].to_s %></span>
    </h1>
    <div class="flex flex-wrap gap-3 justify-start md:justify-end">
      <%= link_to 'Edit Team', edit_volunteers_team_path(@volunteers_team), class: 'inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-green-700 hover:bg-green-800 text-white text-center' %>
      <%= link_to 'Add Member', new_team_assignment_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-green-700 hover:bg-green-800 text-white text-center' %>
      <%= link_to 'New Work Order', new_work_order_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-orange-600 hover:bg-orange-700 text-white text-center' %>
      <%= button_to @volunteers_team, method: :delete, data: { confirm: 'Are you sure? This will remove all team assignments and work orders.' }, form: { class: 'inline-block' }, class: 'inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-orange-600 hover:bg-orange-700 text-white text-center' do %>
        Delete Team
      <% end %>
      <%= link_to 'Back to Teams', volunteers_teams_path, class: 'inline-flex items-center justify-center w-full sm:w-auto px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-black hover:bg-gray-800 text-white text-center' %>
    </div>
  </div>

  <div class="bg-white shadow-xl overflow-hidden sm:rounded-2xl mb-8">
    <div class="px-6 py-6 sm:px-8">
      <h3 class="text-xl md:text-2xl font-bold text-black">Team Information</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-600">Basic details about the volunteer team.</p>
    </div>
    <div class="border-t border-gray-100">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 p-6">
        <div class="flex flex-col bg-gray-50 p-4 rounded-lg">
          <dt class="text-sm font-semibold text-gray-700 uppercase">Team name</dt>
          <dd class="mt-2 text-lg font-bold text-black"><%= @volunteers_team.name %></dd>
        </div>
        <div class="flex flex-col bg-white p-4 rounded-lg">
          <dt class="text-sm font-semibold text-gray-700 uppercase">District</dt>
          <dd class="mt-2 text-lg font-bold text-black"><%= @volunteers_team.district %></dd>
        </div>
        <div class="flex flex-col bg-gray-50 p-4 rounded-lg">
          <dt class="text-sm font-semibold text-gray-700 uppercase">Total volunteers</dt>
          <dd class="mt-2 text-lg font-bold text-black"><%= @volunteers_team.volunteers_count %></dd>
        </div>
        <div class="flex flex-col bg-white p-4 rounded-lg">
          <dt class="text-sm font-semibold text-gray-700 uppercase">Active work orders</dt>
          <dd class="mt-2 text-lg font-bold text-black"><%= @volunteers_team.active_work_orders_count %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Team Members -->
  <div class="mb-10">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-black">Team Members</h2>
      <%= link_to 'Add Member', new_team_assignment_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-green-700 hover:bg-green-800 text-white' %>
    </div>
    
    <% if @team_volunteers.any? %>
      <div class="grid grid-cols-1 gap-4">
        <% @team_volunteers.each do |volunteer| %>
          <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-md hover:shadow-lg transition flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex items-start gap-4 w-full sm:w-auto">
              <div class="flex-shrink-0">
                <!-- Avatar placeholder -->
                <div class="h-10 w-10 sm:h-12 sm:w-12 rounded-full bg-gray-100 flex items-center justify-center text-black font-bold"> <%= volunteer.full_name&.[](0)&.upcase || volunteer.email&.[](0)&.upcase || '?' %> </div>
              </div>
              <div class="min-w-0">
                <p class="text-lg font-semibold text-green-700 hover:text-green-900 truncate">
                  <%= link_to volunteer.full_name, volunteer, class: 'hover:underline block truncate' %>
                </p>
                <p class="text-sm text-gray-600 truncate"><%= volunteer.email %></p>
                <p class="text-xs text-gray-400 mt-1">Joined team: <%= @team_assignments.find { |ta| ta.volunteer_id == volunteer.id }&.created_at&.strftime('%B %d, %Y') %></p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto mt-3 sm:mt-0">
              <div class="py-1 px-3 rounded-full bg-gray-100 text-xs font-semibold text-gray-700">
                <%= volunteer_role_badge(volunteer.role) %>
              </div>
              <%= link_to 'View', volunteer, class: 'bg-black hover:bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-semibold w-full sm:w-auto text-center' %>
              <% if @team_assignments.find { |ta| ta.volunteer_id == volunteer.id } %>
                <%= button_to @team_assignments.find { |ta| ta.volunteer_id == volunteer.id }, method: :delete, data: { confirm: 'Remove this volunteer from the team?' }, form: { class: 'inline-block' }, class: 'bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg text-sm font-semibold w-full sm:w-auto text-center' do %>
                  Remove
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-6">No team members yet.</p>
        <%= link_to 'Add First Member', new_team_assignment_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-green-700 hover:bg-green-800 text-white' %>
      </div>
    <% end %>
  </div>

  <!-- Work Orders -->
  <div>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl md:text-3xl font-extrabold text-black">Work Orders</h2>
      <%= link_to 'New Work Order', new_work_order_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center px-4 py-2 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-orange-600 hover:bg-orange-700 text-white' %>
    </div>
    
    <% if @work_orders.any? %>
      <div class="grid grid-cols-1 gap-4">
        <% @work_orders.each do |work_order| %>
          <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-md hover:shadow-lg transition flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex-1 min-w-0">
              <p class="text-lg font-semibold text-green-700 truncate">
                <%= link_to work_order.title, work_order, class: 'hover:underline block truncate' %>
              </p>
              <p class="text-sm text-gray-600 mt-1 line-clamp-3"><%= truncate(work_order.description, length: 120) %></p>
              <div class="mt-3">
                <p class="text-xs text-gray-500">
                  Assigned by <%= work_order.assigned_by_name %> for <%= work_order.assigned_date.strftime('%B %d, %Y') %>
                </p>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto mt-3 sm:mt-0">
              <%= work_order_status_badge(work_order) %>
              <%= days_until_badge(work_order) %>
              <div class="flex flex-wrap gap-2">
                <%= link_to 'View', work_order, class: 'bg-black hover:bg-gray-800 text-white px-4 py-2 rounded-lg text-sm font-semibold w-full sm:w-auto text-center' %>
                <%= link_to 'Edit', edit_work_order_path(work_order), class: 'bg-green-700 hover:bg-green-800 text-white px-4 py-2 rounded-lg text-sm font-semibold w-full sm:w-auto text-center' %>
                <%= button_to work_order, method: :delete, data: { confirm: 'Are you sure?' }, form: { class: 'inline-block' }, class: 'bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg text-sm font-semibold w-full sm:w-auto text-center' do %>
                  Delete
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-gray-500 mb-6">No work orders yet.</p>
        <%= link_to 'Create First Work Order', new_work_order_path(team_id: @volunteers_team.id), class: 'inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold uppercase text-sm shadow-md transition-colors bg-orange-600 hover:bg-orange-700 text-white' %>
      </div>
    <% end %>
  </div>
</div>
