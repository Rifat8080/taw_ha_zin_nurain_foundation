<%# expects local: volunteers_team (model) and optional header_title, header_subtitle %>
<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div>
    <% action_word = volunteers_team&.persisted? ? 'Edit' : 'Create' %>
    <h1 class="text-xl sm:text-2xl font-extrabold"><span class="text-foundationprimarygreen"><%= action_word %></span> <span class="text-forange">Team</span></h1>
    <p class="mt-1 text-sm text-foundationprimarygreen"><%= local_assigns[:header_subtitle] || (volunteers_team&.persisted? ? 'Update details for this volunteers team.' : 'Add a new volunteers team to the system.') %></p>
  </div>
  <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
    <%= link_to 'All Teams', volunteers_teams_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-forange/10 w-full sm:w-auto justify-center' %>
    <%= link_to 'All Volunteers', volunteers_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border border-gray-200 text-gray-700 hover:bg-forange/10 w-full sm:w-auto justify-center' %>
  </div>
</div>

<div class="bg-white shadow-xl rounded-lg p-4 sm:p-6 border border-forange/10">
  <%= form_with(model: volunteers_team, local: true) do |form| %>
    <% if form.object.errors.any? %>
      <div class="mb-4 rounded-md bg-forange/10 p-4 border border-forange/20">
        <h4 class="text-sm font-semibold text-forange"><%= pluralize(form.object.errors.count, 'error') %> prevented this team from being saved</h4>
        <ul class="mt-2 list-disc list-inside text-sm text-forange">
          <% form.object.errors.full_messages.each do |m| %>
            <li><%= m %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 gap-5">
      <div>
        <%= form.label :name, 'Team name', class: 'block text-sm font-semibold text-foundationprimarygreen' %>
        <%= form.text_field :name, placeholder: 'E.g. Yangon North Volunteers', class: 'mt-2 block w-full px-4 py-3 border border-forange/20 rounded-lg bg-white text-gray-900 font-medium focus:outline-none focus:ring-4 focus:ring-foundationprimarygreen/20 focus:border-foundationprimarygreen' %>
      </div>

      <div>
        <%= form.label :district, 'District', class: 'block text-sm font-semibold text-foundationprimarygreen' %>
        <%= form.text_area :district, rows: 3, placeholder: 'City, township or district', class: 'mt-2 block w-full px-4 py-3 border border-forange/20 rounded-lg bg-white text-gray-900 font-medium focus:outline-none focus:ring-4 focus:ring-foundationprimarygreen/20 focus:border-foundationprimarygreen' %>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-3">
        <% submit_label = form.object.persisted? ? 'Update Team' : 'Create Team' %>
        <%= form.submit submit_label, class: 'inline-flex items-center justify-center px-6 py-3 rounded-lg btn-primary text-white text-base font-bold shadow-xl transform hover:-translate-y-0.5 transition w-full sm:w-auto' %>

        <% cancel_path = form.object.persisted? ? form.object : volunteers_teams_path %>
        <%= link_to 'Cancel', cancel_path, class: 'inline-flex items-center justify-center px-4 py-2 rounded-lg bg-white border border-forange text-forange font-semibold w-full sm:w-auto' %>
      </div>
    </div>
  <% end %>
</div>
