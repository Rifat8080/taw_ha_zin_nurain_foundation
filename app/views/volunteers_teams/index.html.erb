<% content_for :title, "Volunteer Teams" %>
<div class="container mx-auto px-8 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-6 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">
        Volunteer <span class="text-forange">Teams</span>
      </h1>
      <p class="mt-2 text-lg text-gray-700 text-center">Organize and manage volunteers by district and team assignments.</p>
    </div>
  </div>

  <!-- Controls (search / filter / actions) -->
  <div class="mb-8 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <%= form_with url: volunteers_teams_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
      <div class="flex-1">
        <%= form.text_field :search, placeholder: "Search teams by name or district...", value: params[:search], class: "w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500" %>
      </div>
      <div class="flex items-center gap-3">
        <%= form.select :district, options_for_select([['All Districts', '']] + district_options, params[:district]), {}, { class: 'px-4 py-3 border border-foundationprimarygreen/30 rounded-lg text-sm' } %>
        <%= form.submit 'Filter', class: 'px-6 py-3 btn-primary text-white font-semibold rounded-lg transition-all duration-200 transform will-change-transform hover:scale-105 hover:shadow-xl' %>
        <% if params[:search].present? || params[:district].present? %>
          <%= link_to 'Clear', volunteers_teams_path, class: 'px-6 py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg transition-colors' %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 flex items-center justify-between">
      <div class="flex flex-wrap gap-2">
        <span class="text-sm font-medium text-gray-600 mr-2">Popular districts:</span>
        <% (district_options || []).first(5).each do |label, val| %>
          <% next if val.blank? %>
          <%= link_to volunteers_teams_path(district: val), class: "inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-700 hover:bg-forange/10 hover:text-forange border border-transparent" do %>
            <%= label %>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-3">
        <% if current_user&.role == 'admin' %>
          <%= link_to new_volunteers_team_path, class: "inline-flex items-center whitespace-nowrap px-6 py-3 bg-foundationprimarygreen hover:bg-forange text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
            <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
            New Team
          <% end %>
        <% end %>
        <%= link_to volunteers_path, class: 'px-4 py-2 bg-white border border-foundationprimarygreen text-foundationprimarygreen rounded-md hover:bg-foundationprimarygreen/10 text-sm' do %>
          All Volunteers
        <% end %>
      </div>
    </div>
  </div>

  <!-- Teams grid -->
  <div id="teams" class="relative z-10">
    <% if @volunteers_teams.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @volunteers_teams.each do |team| %>
          <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-foundationprimarygreen/10">
            <div class="px-6 py-5">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900"><%= team.name %></h3>
                  <p class="mt-1 text-sm text-gray-500"><%= team.district %></p>
                </div>
                <div class="text-sm"><%= team_status_badge(team) %></div>
              </div>

              <div class="mt-4 flex items-center justify-between text-sm text-gray-600">
                <div>
                  <%= link_to "#{team.volunteers_count} volunteers", team_assignments_path(team_id: team.id), class: 'text-foundationprimarygreen hover:text-forange font-medium' %>
                </div>
                <div>
                  <%= link_to "#{team.active_work_orders_count} active orders", work_orders_path(team_id: team.id), class: 'text-forange hover:text-foundationprimarygreen font-medium' %>
                </div>
              </div>

              <div class="mt-4 grid grid-cols-2 gap-2">
                <%= link_to 'View Details', team, class: 'px-3 py-2 rounded text-sm bg-foundationprimarygreen hover:bg-forange text-white text-center' %>
                <%= link_to 'Edit Team', edit_volunteers_team_path(team), class: 'px-3 py-2 rounded text-sm bg-white border border-foundationprimarygreen text-foundationprimarygreen text-center' %>
                <%= link_to 'Add Member', new_team_assignment_path(team_id: team.id), class: 'px-3 py-2 rounded text-sm bg-forange hover:bg-forange/90 text-white text-center' %>
                <%= link_to 'New Work Order', new_work_order_path(team_id: team.id), class: 'px-3 py-2 rounded text-sm bg-white border border-forange text-forange text-center' %>
              </div>

              <div class="mt-4 text-center">
                <%= link_to 'Delete Team', team, method: :delete, data: { confirm: 'Are you sure? This will remove all team assignments and work orders.' }, class: 'inline-flex items-center px-4 py-2 rounded-md bg-red-500 hover:bg-red-700 text-white text-sm' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-gray-500">No teams found.</p>
      </div>
    <% end %>
  </div>
</div>
