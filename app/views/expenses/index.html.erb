<% content_for :title, "Expenses" %>

<div class="container mx-auto px-4 sm:px-6 py-8">
  <% if notice.present? %>
    <div class="mb-6 p-4 bg-forange/10 border-l-4 border-forange rounded-r-lg shadow-sm flex items-center" id="notice">
      <svg class="h-5 w-5 text-forange mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span class="text-forange font-medium"><%= notice %></span>
    </div>
  <% end %>
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-6 gap-3">
    <div class="w-full">
      <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight">Our <span class="text-forange">Expenses</span></h1>
      <p class="mt-1 text-sm sm:text-base text-gray-700">List of recorded expenses and spendings. Tap an expense to view details.</p>
      <%# Determine selected project early so header can show contextual total %>
      <% selected_project = if params[:project_id].present?
                             (@projects || []).detect { |pp| pp.id.to_s == params[:project_id].to_s } || Project.find_by(id: params[:project_id]) rescue nil
                           end %>

      <div class="mt-3">
        <% if selected_project.present? %>
          <% proj_total = @project_sums[selected_project.id] || 0 %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-50 text-green-700 border border-green-200">
            Total for <span class="ml-2 font-semibold text-gray-900"><%= selected_project.name %></span>
            <span class="ml-3 font-semibold">৳<%= number_with_delimiter(proj_total) %></span>
          </span>
        <% elsif params[:search].present? %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-50 text-green-700 border border-green-200">
            Search results total: <span class="ml-2 font-semibold">৳<%= number_with_delimiter(@filtered_expenses_total || 0) %></span>
          </span>
        <% else %>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-50 text-green-700 border border-green-200">
            Total expenses: <span class="ml-2 font-semibold">৳<%= number_with_delimiter(@overall_expenses_total || 0) %></span>
          </span>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Search & Filter -->
  <div class="mb-6 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-4 sm:p-6">
    <%= form_with url: expenses_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3 items-start" do |form| %>
      <div class="flex-1 w-full">
        <%= form.text_field :search, value: params[:search], placeholder: "Search expenses by title, project or amount...", class: "w-full px-3 py-3 sm:px-4 sm:py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500 text-sm sm:text-base" %>
      </div>

      <div class="w-full md:w-64">
        <% projects_for_filter = if defined?(@projects) && @projects.present?
                                  @projects
                                else
                                  begin
                                    Project.order(:name).limit(10)
                                  rescue => _e
                                    []
                                  end
                                end %>
        <%= form.select :project_id, options_from_collection_for_select(projects_for_filter, :id, :name, params[:project_id]), { include_blank: "All projects" }, class: "w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg" %>
      </div>

      <div class="flex gap-2 w-full sm:w-auto">
        <%= form.submit "Search", class: "px-4 sm:px-6 py-2 sm:py-3 btn-primary text-white font-semibold rounded-lg text-sm sm:text-base" %>
        <% if params[:search].present? || params[:project_id].present? %>
          <%= link_to "Clear", expenses_path, class: "px-4 sm:px-6 py-2 sm:py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg text-sm sm:text-base" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <%= link_to new_expense_path, class: "inline-flex items-center whitespace-nowrap px-6 py-3 bg-foundationprimarygreen hover:bg-forange text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
        New Expense
      <% end %>
    </div>
    <% if @expenses.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <% @expenses.each do |expense| %>
          <div class="relative bg-white border border-gray-200 rounded-lg p-4 sm:p-6 shadow-sm hover:shadow-lg transition-transform duration-150 flex flex-col justify-between">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-xs text-gray-500 uppercase tracking-wide">Title</p>
                <p class="text-base font-semibold text-gray-900 truncate"><%= expense.title %></p>
              </div>

              <div class="flex items-start gap-2 ml-2">
                <div class="text-right">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-50 text-red-600 border border-red-200">৳<%= number_with_delimiter(expense.amount) %></span>
                </div>

                <div class="flex items-center gap-2 flex-nowrap">
                  <%= link_to expense_path(expense), class: 'inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-50 hover:bg-gray-100 text-sm text-indigo-600 font-medium' do %>
                    <i class="fa-solid fa-eye"></i>
                    <span class="hidden md:inline">View</span>
                  <% end %>

                  <%= link_to edit_expense_path(expense), class: 'inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gray-50 hover:bg-gray-100 text-sm text-yellow-600 font-medium' do %>
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span class="hidden md:inline">Edit</span>
                  <% end %>

                  <%= button_to expense_path(expense), method: :delete, data: { confirm: 'Are you sure?' }, form: { class: 'inline-block' }, class: 'btn-delete inline-flex items-center gap-2 px-3 py-1 rounded-full bg-forange text-white text-sm font-medium hover:brightness-95' do %>
                    <i class="fa-solid fa-trash"></i>
                    <span class="hidden md:inline">Delete</span>
                  <% end %>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <p class="text-sm text-gray-700 font-medium truncate"><i class="fa-solid fa-folder-open mr-2 text-gray-400"></i><strong>Project:</strong> <span class="font-normal text-gray-700"><%= expense.project&.name || '\u2014' %></span></p>
              <p class="text-xs text-gray-500 mt-2"><i class="fa-solid fa-calendar-days mr-2 text-gray-400"></i><%= expense.expense_date.strftime("%b %d, %Y") %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
        <p class="text-gray-500">No expenses found.</p>
        <%= link_to "Create the first expense", new_expense_path, class: "text-blue-500 hover:text-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
