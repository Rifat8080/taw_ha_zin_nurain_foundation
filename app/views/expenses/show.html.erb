<% content_for :title, "Expense" %>

<div class="container mx-auto px-4 sm:px-6 py-8">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white shadow-lg rounded-2xl overflow-hidden">
      <!-- Header -->
      <div class="px-6 py-6 bg-gradient-to-r from-[rgba(var(--color-foundationprimarygreen)/0.06)] via-transparent to-[rgba(var(--color-forange)/0.04)] border-b">
        <div class="flex items-start gap-4 sm:items-center sm:justify-between flex-col sm:flex-row">
          <div class="min-w-0">
            <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-foundationprimarygreen leading-tight">Expense <span class="text-forange">Details</span></h1>
            <p class="mt-1 text-sm text-gray-600">A concise view of the expense record and related project.</p>
          </div>
          <div class="mt-3 sm:mt-0 flex items-center gap-3 w-full sm:w-auto">
            <%= link_to expenses_path, class: "inline-flex items-center gap-2 px-3 py-2 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 text-sm" do %>
              <i class="fa-solid fa-arrow-left"></i>
              <span class="hidden sm:inline">Back</span>
            <% end %>
            <%= link_to edit_expense_path(@expense), class: "inline-flex items-center gap-2 px-3 py-2 rounded-md bg-yellow-500 text-white hover:bg-yellow-600 text-sm" do %>
              <i class="fa-solid fa-pen-to-square"></i>
              <span class="hidden sm:inline">Edit</span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="px-5 sm:px-8 py-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
          <!-- Main details -->
          <div class="md:col-span-2 bg-white">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-foundationprimarygreen/10 flex items-center justify-center text-foundationprimarygreen text-xl font-bold">
                <i class="fa-solid fa-receipt"></i>
              </div>
              <div class="min-w-0">
                <p class="text-sm text-gray-500">Title</p>
                <p class="text-lg sm:text-2xl font-semibold text-gray-900 truncate"><%= @expense.title %></p>
                <p class="text-sm text-gray-500">Reference: <%= @expense.respond_to?(:reference) ? (@expense.reference.presence || '\u2014') : '\u2014' %></p>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 bg-gray-50 rounded-lg border">
                <p class="text-xs text-gray-500 uppercase tracking-wide">Amount</p>
                <p class="mt-2 text-2xl font-bold text-red-600">৳<%= number_with_delimiter(@expense.amount) %></p>
              </div>

              <div class="p-4 bg-gray-50 rounded-lg border">
                <p class="text-xs text-gray-500 uppercase tracking-wide">Date</p>
                <p class="mt-2 text-sm text-gray-900"><%= @expense.expense_date.strftime("%B %d, %Y") %></p>
              </div>
            </div>

            <div class="mt-6 p-4 bg-white rounded-lg border">
              <p class="text-xs text-gray-500 uppercase tracking-wide">Project</p>
              <p class="mt-2 text-sm text-gray-900"><%= @expense.project&.name || '\u2014' %></p>
            </div>

            <%# Notes - show if model responds to notes and it has content %>
            <div class="mt-4 p-4 bg-white rounded-lg border">
              <p class="text-xs text-gray-500 uppercase tracking-wide">Notes</p>
              <div class="mt-2 text-sm text-gray-700">
                <% if @expense.respond_to?(:notes) && @expense.notes.present? %>
                  <%= simple_format(@expense.notes) %>
                <% else %>
                  &mdash;
                <% end %>
              </div>
            </div>
          </div>

          <!-- Actions aside -->
          <aside class="md:col-span-1 sticky top-6 self-start">
            <div class="p-4 bg-forange/5 border border-forange/20 rounded-lg">
              <p class="text-xs text-forange font-semibold uppercase">Quick actions</p>
              <div class="mt-3 flex flex-col gap-3">
                <%= link_to expense_path(@expense), class: "w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-md bg-gray-50 hover:bg-gray-100 text-sm text-indigo-600 font-medium" do %>
                  <i class="fa-solid fa-eye"></i>
                  View
                <% end %>

                <%= link_to edit_expense_path(@expense), class: "w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-md bg-yellow-500 text-white hover:bg-yellow-600 text-sm font-medium" do %>
                  <i class="fa-solid fa-pen-to-square"></i>
                  Edit
                <% end %>

                <%= button_to expense_path(@expense), method: :delete, data: { confirm: 'Are you sure?' }, form: { class: 'w-full' }, class: 'w-full btn-delete inline-flex items-center justify-center gap-2 px-3 py-2 rounded-md bg-forange text-white text-sm font-medium hover:brightness-95' do %>
                  <i class="fa-solid fa-trash"></i>
                  Delete
                <% end %>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>
