<%= form_with(model: healthcare_request, local: true, class: "space-y-6") do |form| %>

  <% if healthcare_request.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(healthcare_request.errors.count, "error") %> prevented this request from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% healthcare_request.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="max-w-6xl mx-auto">
    <div class="bg-white rounded-3xl shadow-2xl ring-1 ring-foundationprimarygreen/6 overflow-hidden">
      <div class="bg-foundation-gradient p-6 sm:p-8 backdrop-blur-sm">
        <div class="text-center">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
            <span class="text-foundationprimarygreen"><%= healthcare_request.persisted? ? "Edit" : "Create" %></span>
            <span class="text-forange"> Healthcare Request</span>
          </h2>
          <p class="mt-3 text-sm sm:text-base text-gray-700 max-w-2xl mx-auto">Share the patient's details and attach prescription or documents to help donors understand the need. Be concise and factual — donors read the headline first.</p>
        </div>
      </div>

      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Main inputs -->
        <div class="md:col-span-8 lg:col-span-8 space-y-6">
          <div>
            <%= form.label :patient_name, class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2 relative">
              <%= form.text_field :patient_name, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": healthcare_request.errors[:patient_name].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:patient_name].any?}] %>
            </div>
            <p class="mt-2 text-sm text-gray-500">Full name of the patient requiring medical assistance</p>
          </div>

          <div>
            <%= form.label :prescription_url, "Prescription / Medical Document URL", class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2 relative">
              <%= form.url_field :prescription_url, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": healthcare_request.errors[:prescription_url].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:prescription_url].any?}], placeholder: "https://..." %>
              <% if healthcare_request.prescription_url.present? %>
                <div class="absolute right-3 top-1/2 -translate-y-1/2">
                  <%= link_to(healthcare_request.prescription_url, target: "_blank", rel: "noopener", class: "text-sm text-foundationprimarygreen hover:underline inline-flex items-center gap-2") do %>
                    <svg class="w-4 h-4 text-foundationprimarygreen" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 3h7v7M10 14L21 3"/></svg>
                  <% end %>
                </div>
              <% end %>
            </div>
            <p class="mt-2 text-sm text-gray-500">Link to prescription or relevant medical documents (optional)</p>
          </div>

          <div>
            <%= form.label :reason, "Medical Reason & Details", class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2">
              <%= form.text_area :reason, rows: 8, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": healthcare_request.errors[:reason].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:reason].any?}], placeholder: "Describe the medical need and estimated costs..." %>
            </div>
            <p class="mt-2 text-sm text-gray-500">Provide comprehensive details about the medical situation</p>
          </div>
        </div>

        <!-- Sidebar: stats & admin controls -->
        <aside class="md:col-span-4 lg:col-span-4 space-y-6">
          <div class="sticky top-20">
            <div class="bg-white rounded-2xl p-4 shadow-lg border border-foundationprimarygreen/5">
              <div class="flex items-start gap-4">
                <div class="flex-1">
                  <div class="text-xs font-semibold text-gray-500">Current Donations</div>
                  <div class="mt-1 text-3xl font-extrabold text-foundationprimarygreen">৳<%= number_with_delimiter(healthcare_request.total_donations) %></div>
                  <div class="text-xs text-gray-500 mt-1">Donors: <span class="font-semibold text-gray-700"><%= healthcare_request.donation_count %></span></div>
                </div>
                <div class="ml-2 flex-shrink-0 bg-foundationprimarygreen/10 rounded-full p-2">
                  <svg class="w-6 h-6 text-foundationprimarygreen/90" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3"/></svg>
                </div>
              </div>
            </div>

            <% if healthcare_request.persisted? %>
              <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
                <div class="text-sm font-medium text-gray-800">Status</div>
                <div class="mt-2 text-sm text-gray-600">
                  <p>Status: <span class="font-medium <%= case healthcare_request.status when 'pending' then 'text-yellow-600' when 'approved' then 'text-foundationprimarygreen' when 'rejected' then 'text-red-600' when 'completed' then 'text-blue-600' else 'text-gray-600' end %>"><%= healthcare_request.status.capitalize %></span></p>
                  <p>Approved: <span class="font-medium <%= healthcare_request.approved? ? 'text-foundationprimarygreen' : 'text-yellow-600' %>"><%= healthcare_request.approved? ? 'Yes' : 'Pending' %></span></p>
                </div>
              </div>
            <% end %>

            <% if current_user&.role == 'admin' %>
              <div class="mt-4 bg-white rounded-lg p-4 border border-gray-100">
                <div class="text-sm font-medium text-foundationprimarygreen">Admin Controls</div>
                <div class="mt-3 space-y-3">
                  <div>
                    <%= form.label :status, class: "block text-xs font-medium text-gray-700" %>
                    <%= form.select :status, options_for_select([['Pending','pending'], ['Approved','approved'], ['Rejected','rejected'], ['Completed','completed']], healthcare_request.status), {}, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
                  </div>
                  <div>
                    <%= form.label :approved, "Manual Approval", class: "block text-xs font-medium text-gray-700" %>
                    <%= form.select :approved, options_for_select([['Pending Approval', false], ['Approved', true]], healthcare_request.approved), {}, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </aside>
      </div>

      <!-- Actions -->
      <div class="mt-6">
        <div class="flex flex-col-reverse sm:flex-row items-center sm:justify-end gap-3">
          <%= link_to 'Cancel', healthcare_request.persisted? ? healthcare_request_path(healthcare_request) : healthcare_requests_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-3 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
          <%= form.submit healthcare_request.persisted? ? 'Update Request' : 'Submit Request', class: "w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 rounded-full text-sm text-white font-semibold shadow-lg btn-primary hover:scale-[1.02] transition-transform duration-150" %>
        </div>
        <p class="mt-3 text-xs text-gray-500 text-center sm:text-right">By submitting you confirm all details are accurate. Admins can update status and approvals later.</p>
      </div>
    </div>
    </div>
  </div>
<% end %>
