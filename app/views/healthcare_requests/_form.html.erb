<%= form_with(model: healthcare_request, local: true, class: "space-y-6") do |form| %>

  <% if healthcare_request.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(healthcare_request.errors.count, "error") %> prevented this request from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% healthcare_request.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-lg p-6">
    <div class="mb-4">
      <h2 class="text-4xl text-center font-bold">
        <span class="text-foundationprimarygreen"><%= healthcare_request.persisted? ? "Edit" : "Create" %></span>
        <span class="text-forange">Healthcare Request</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left: Main inputs -->
      <div class="lg:col-span-2 space-y-4">
        <div>
          <%= form.label :patient_name, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_field :patient_name, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": healthcare_request.errors[:patient_name].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:patient_name].any?}] %>
          </div>
          <p class="mt-1 text-sm text-gray-500">Full name of the patient requiring medical assistance</p>
        </div>

        <div>
          <%= form.label :prescription_url, "Prescription / Medical Document URL", class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.url_field :prescription_url, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": healthcare_request.errors[:prescription_url].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:prescription_url].any?}], placeholder: "https://..." %>
          </div>
          <p class="mt-1 text-sm text-gray-500">Link to prescription or relevant medical documents (optional)</p>
        </div>

        <div>
          <%= form.label :reason, "Medical Reason & Details", class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_area :reason, rows: 8, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": healthcare_request.errors[:reason].none?, "border-red-400 focus:ring-red-500": healthcare_request.errors[:reason].any?}], placeholder: "Describe the medical need and estimated costs..." %>
          </div>
          <p class="mt-1 text-sm text-gray-500">Provide comprehensive details about the medical situation</p>
        </div>
      </div>

      <!-- Right: Summary / admin controls -->
      <div class="space-y-4">
        <div class="bg-foundationprimarygreen/5 border border-foundationprimarygreen/10 rounded-lg p-4">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-foundationprimarygreen mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <div>
              <div class="text-sm font-medium text-foundationprimarygreen">Current Donations</div>
              <div class="text-lg font-semibold text-green-700">৳<%= number_with_delimiter(healthcare_request.total_donations) %></div>
            </div>
          </div>
        </div>

        <% if healthcare_request.persisted? %>
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <div class="text-sm font-medium text-gray-800">Status</div>
            <div class="mt-2 text-sm text-gray-600">
              <p>Status: <span class="font-medium <%= case healthcare_request.status when 'pending' then 'text-yellow-600' when 'approved' then 'text-green-600' when 'rejected' then 'text-red-600' when 'completed' then 'text-blue-600' else 'text-gray-600' end %>"><%= healthcare_request.status.capitalize %></span></p>
              <p>Approved: <span class="font-medium <%= healthcare_request.approved? ? 'text-green-600' : 'text-yellow-600' %>"><%= healthcare_request.approved? ? 'Yes' : 'Pending' %></span></p>
            </div>
          </div>
        <% end %>

        <% if current_user&.role == 'admin' %>
          <div>
            <%= form.label :status, class: "block text-sm font-medium text-foundationprimarygreen" %>
            <%= form.select :status, options_for_select([['Pending','pending'], ['Approved','approved'], ['Rejected','rejected'], ['Completed','completed']], healthcare_request.status), {}, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
            <p class="mt-1 text-sm text-gray-500">Admin only: update the public status</p>
          </div>

          <div>
            <%= form.label :approved, "Manual Approval", class: "block text-sm font-medium text-foundationprimarygreen" %>
            <%= form.select :approved, options_for_select([['Pending Approval', false], ['Approved', true]], healthcare_request.approved), {}, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
            <p class="mt-1 text-sm text-gray-500">Admin only: manually override approval</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-3">
      <%= link_to 'Cancel', healthcare_request.persisted? ? healthcare_request_path(healthcare_request) : healthcare_requests_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
      <%= form.submit healthcare_request.persisted? ? 'Update Request' : 'Submit Request', class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 rounded-md text-sm text-white font-medium shadow-md btn-primary" %>
    </div>
  </div>
<% end %>
