<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900"><%= @work_order.title %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @work_order.team_name %> • <%= @work_order.team_district %></p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to 'View Team', @work_order.volunteers_team, class: 'inline-flex items-center px-4 py-2 rounded-md bg-purple-500 hover:bg-purple-600 text-white text-sm font-medium' %>
      <%= link_to 'Edit', edit_work_order_path(@work_order), class: 'inline-flex items-center px-4 py-2 rounded-md bg-foundationprimarygreen hover:opacity-95 text-white text-sm font-medium' %>
      <%= link_to 'Duplicate', new_work_order_path(team_id: @work_order.team_id), class: 'inline-flex items-center px-4 py-2 rounded-md bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium' %>
      <%= link_to 'Delete', @work_order, method: :delete, data: { confirm: 'Are you sure?' }, class: 'inline-flex items-center px-4 py-2 rounded-md bg-red-500 hover:bg-red-600 text-white text-sm font-medium' %>
      <%= link_to 'Back', work_orders_path, class: 'inline-flex items-center px-3 py-2 rounded-md bg-white border text-sm text-gray-700 hover:bg-gray-50' %>
    </div>
  </div>

  <div class="bg-white rounded-3xl shadow-2xl ring-1 ring-foundationprimarygreen/6 overflow-hidden">
    <div class="bg-foundation-gradient p-6 sm:p-8 backdrop-blur-sm">
      <div class="text-center">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight">
          <span class="text-foundationprimarygreen">Work Order</span>
        </h2>
        <p class="mt-2 text-sm text-gray-700 max-w-2xl mx-auto">Details and context so volunteers can complete the task reliably.</p>
      </div>
    </div>

    <div class="p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-8 lg:col-span-8 space-y-6">
          <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-semibold text-gray-500">Status</div>
                <div class="mt-2"> <%= work_order_status_badge(@work_order) %> </div>
              </div>
              <div class="text-right">
                <div class="text-xs font-semibold text-gray-500">Assigned date</div>
                <div class="mt-2 text-sm text-gray-800"><%= @work_order.assigned_date.strftime('%B %d, %Y') %></div>
                <div class="mt-1"><%= days_until_badge(@work_order) %></div>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-100">
            <h3 class="text-sm font-semibold text-gray-600">Description</h3>
            <div class="mt-3 text-sm text-gray-800 leading-relaxed"><%= simple_format(@work_order.description) %></div>
          </div>

          <div class="bg-white rounded-xl p-6 border border-gray-100">
            <h3 class="text-sm font-semibold text-gray-600">Checklist</h3>
            <div class="mt-3">
              <ul class="border border-gray-200 rounded-md divide-y divide-gray-200">
                <% @work_order.checklist_items.each_with_index do |item, index| %>
                  <li class="pl-4 pr-4 py-3 flex items-center text-sm">
                    <div class="w-8 h-8 flex items-center justify-center bg-gray-100 rounded-full text-gray-700 font-medium mr-3"> <%= index + 1 %> </div>
                    <div class="flex-1 text-gray-800"><%= item %></div>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>

        <aside class="md:col-span-4 lg:col-span-4 space-y-6">
          <div class="sticky top-20">
            <div class="bg-white rounded-2xl p-4 shadow-lg border border-foundationprimarygreen/5">
              <div class="flex items-start gap-4">
                <div class="flex-1">
                  <div class="text-xs font-semibold text-gray-500">Assigned Team</div>
                  <div class="mt-1 text-lg font-extrabold text-gray-800"><%= @work_order.team_name %></div>
                  <div class="text-xs text-gray-500 mt-1">Assigned by: <span class="font-semibold text-gray-700"><%= @work_order.assigned_by_name %></span></div>
                </div>
              </div>
            </div>

            <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
              <div class="text-sm font-medium text-gray-800">Scheduling</div>
              <div class="mt-2 text-sm text-gray-600">
                <div class="flex items-center justify-between">
                  <div class="text-xs text-gray-500">Assigned date</div>
                  <div class="text-sm text-gray-800"><%= @work_order.assigned_date.strftime('%b %d, %Y') %></div>
                </div>
                <div class="mt-2 text-xs"><%= days_until_badge(@work_order) %></div>
              </div>
            </div>

            <div class="mt-4 bg-white rounded-lg p-4 border border-gray-100">
              <div class="text-sm font-medium text-foundationprimarygreen">Meta</div>
              <div class="mt-3 space-y-2 text-sm text-gray-700">
                <div><span class="text-gray-500">District:</span> <span class="font-medium text-gray-800"><%= @work_order.team_district %></span></div>
                <div><span class="text-gray-500">Assigned by:</span> <span class="font-medium text-gray-800"><%= @work_order.assigned_by_name %></span></div>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <div class="mt-6">
        <div class="flex flex-col-reverse sm:flex-row items-center sm:justify-end gap-3">
          <%= link_to 'Back to List', work_orders_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-3 border rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
          <%= link_to 'Edit Work Order', edit_work_order_path(@work_order), class: "w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 rounded-full text-sm text-white font-semibold btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
