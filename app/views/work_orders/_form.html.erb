<%= form_with(model: work_order, local: true, class: "space-y-6") do |form| %>

  <% if work_order.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(work_order.errors.count, "error") %> prevented this work order from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% work_order.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="max-w-6xl mx-auto">
    <div class="bg-white rounded-3xl shadow-2xl ring-1 ring-foundationprimarygreen/6 overflow-hidden">
      <div class="bg-foundation-gradient p-6 sm:p-8 backdrop-blur-sm">
        <div class="text-center">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
            <span class="text-foundationprimarygreen"><%= work_order.persisted? ? "Edit" : "Create" %></span>
            <span class="text-forange"> Work Order</span>
          </h2>
          <p class="mt-3 text-sm sm:text-base text-gray-700 max-w-2xl mx-auto">Create or update a task for a team — include clear title, description and a checklist so volunteers know what to do.</p>
        </div>
      </div>

      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
          <div class="md:col-span-8 lg:col-span-8 space-y-6">
            <div>
              <%= form.label :team_id, 'Team', class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.select :team_id, options_from_collection_for_select(teams, :id, :name, work_order.team_id), { prompt: 'Select a team' }, class: "block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Which team should complete this work order</p>
            </div>

            <div>
              <%= form.label :title, 'Title', class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.text_area :title, rows: 2, class: "block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Short, descriptive headline for the work</p>
            </div>

            <div>
              <%= form.label :description, 'Description', class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.text_area :description, rows: 6, class: "block w-full rounded-xl shadow-sm sm:text-sm px-4 py-4 border bg-white/60 backdrop-blur-[2px]" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Include steps, context and any important notes for volunteers</p>
            </div>

            <div>
              <%= form.label :checklist, 'Checklist (one item per line)', class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.text_area :checklist, rows: 6, placeholder: "Task 1\nTask 2\nTask 3", class: "block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Each line will become an actionable checklist item</p>
            </div>
          </div>

          <aside class="md:col-span-4 lg:col-span-4 space-y-6">
            <div class="sticky top-20">
              <div class="bg-white rounded-2xl p-4 shadow-lg border border-foundationprimarygreen/5">
                <div class="flex items-start gap-4">
                  <div class="flex-1">
                    <div class="text-xs font-semibold text-gray-500">Assigned Team</div>
                    <div class="mt-1 text-lg font-extrabold text-gray-800"><%= teams.find { |t| t.id == work_order.team_id }&.name || 'No team selected' %></div>
                    <div class="text-xs text-gray-500 mt-1">Assigned by: <span class="font-semibold text-gray-700"><%= users.find { |u| u.id == work_order.assigned_by }&.full_name || (work_order.assigned_by.present? ? work_order.assigned_by : '—') %></span></div>
                  </div>
                </div>
              </div>

              <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
                <div class="text-sm font-medium text-gray-800">Scheduling</div>
                <div class="mt-2 text-sm text-gray-600">
                  <div class="mt-2">
                    <%= form.label :assigned_date, 'Assigned Date', class: "block text-xs font-medium text-gray-700" %>
                    <% if work_order.new_record? %>
                      <%= form.date_field :assigned_date, readonly: true, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border bg-gray-50 text-gray-600 cursor-not-allowed" %>
                      <p class="mt-2 text-xs text-green-600">Automatically set to today's date for new work orders</p>
                    <% else %>
                      <%= form.date_field :assigned_date, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="mt-4 bg-white rounded-lg p-4 border border-gray-100">
                <div class="text-sm font-medium text-foundationprimarygreen">Assignment</div>
                <div class="mt-3 space-y-3">
                  <div>
                    <%= form.label :assigned_by, 'Assigned By', class: "block text-xs font-medium text-gray-700" %>
                    <% if work_order.new_record? %>
                      <%= form.select :assigned_by, options_from_collection_for_select(users, :id, :full_name, work_order.assigned_by), { prompt: 'Select who is assigning this' }, { readonly: true, disabled: true, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border bg-gray-50 text-gray-600 cursor-not-allowed" } %>
                      <%= form.hidden_field :assigned_by %>
                      <p class="mt-2 text-xs text-green-600">Automatically set to current user</p>
                    <% else %>
                      <%= form.select :assigned_by, options_from_collection_for_select(users, :id, :full_name, work_order.assigned_by), {}, class: "mt-1 block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border" %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </aside>
        </div>

        <div class="mt-6">
          <div class="flex flex-col-reverse sm:flex-row items-center sm:justify-end gap-3">
            <%= link_to 'Cancel', work_order.persisted? ? work_order_path(work_order) : work_orders_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-3 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
            <%= form.submit work_order.persisted? ? 'Update Work Order' : 'Create Work Order', class: "w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 rounded-full text-sm text-white font-semibold shadow-lg btn-primary hover:scale-[1.02] transition-transform duration-150" %>
          </div>
          <p class="mt-3 text-xs text-gray-500 text-center sm:text-right">Provide clear steps and due dates so volunteers can complete the task reliably.</p>
        </div>
      </div>
    </div>
  </div>
<% end %>
