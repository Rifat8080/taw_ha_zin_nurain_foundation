<% content_for :title, 'Work Orders' %>
<div class="container mx-auto px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 p-4 bg-forange/10 border-l-4 border-forange rounded-r-lg shadow-sm flex items-center" id="notice">
      <svg class="h-5 w-5 text-forange mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span class="text-forange font-medium"><%= notice %></span>
    </div>
  <% end %>

  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-8 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">
        Work <span class="text-forange">Orders</span>
      </h1>
      <p class="mt-2 text-lg text-gray-700 text-center">Create, assign and track field work orders for your volunteer teams.</p>
    </div>
  </div>

  <!-- Search / Filter / Actions -->
  <div class="mb-8 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <%= form_with url: work_orders_path, method: :get, local: true, class: 'flex flex-col md:flex-row gap-4' do |form| %>
      <div class="flex-1">
        <%= form.text_field :search, placeholder: 'Search orders by title, description or team...', value: params[:search], class: 'w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500' %>
      </div>
      <div class="flex items-center gap-3">
        <%= form.select :status, options_for_select([['All Status', ''], ['Upcoming', 'upcoming'], ['Past', 'past']], params[:status]), {}, { class: 'px-4 py-3 border border-foundationprimarygreen/30 rounded-lg text-sm' } %>
        <%= form.submit 'Search', class: 'px-6 py-3 btn-primary text-white font-semibold rounded-lg transition-all duration-200 transform hover:scale-105 hover:shadow-xl bg-foundationprimarygreen hover:bg-forange' %>
        <% if params[:search].present? || params[:status].present? %>
          <%= link_to 'Clear', work_orders_path, class: 'px-6 py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg transition-colors' %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 flex items-center justify-between">
      <div class="flex flex-wrap gap-2">
        <span class="text-sm font-medium text-gray-600 mr-2">Quick filters:</span>
        <%= link_to work_orders_path(status: 'upcoming'), class: 'inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-700 hover:bg-forange/10 hover:text-forange' do %>
          Upcoming
        <% end %>
        <%= link_to work_orders_path(status: 'past'), class: 'inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-700 hover:bg-forange/10 hover:text-forange' do %>
          Past
        <% end %>
      </div>

      <div class="flex items-center gap-3">
        <% if current_user&.role == 'admin' %>
          <%= link_to new_work_order_path, class: 'inline-flex items-center whitespace-nowrap px-6 py-3 bg-foundationprimarygreen hover:bg-forange text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200' do %>
            <i class='fa-solid fa-plus mr-2' aria-hidden='true'></i>
            New Work Order
          <% end %>
        <% end %>
        <%= link_to volunteers_teams_path, class: 'px-4 py-2 bg-white border border-foundationprimarygreen text-foundationprimarygreen rounded-md hover:bg-foundationprimarygreen/10 text-sm' do %>
          Teams
        <% end %>
      </div>
    </div>
  </div>

  <!-- Orders grid -->
  <div id="work_orders" class="relative z-10">
    <% if @work_orders.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @work_orders.each do |work_order| %>
          <div class="bg-white rounded-lg shadow-lg overflow-hidden border border-foundationprimarygreen/10">
            <div class="px-6 py-5">
              <div class="flex items-start justify-between">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 truncate"><%= work_order.title %></h3>
                  <p class="mt-1 text-sm text-gray-500"><%= truncate(work_order.description, length: 120) %></p>
                </div>
                <div class="text-sm"><%= work_order_status_badge(work_order) %></div>
              </div>

              <div class="mt-4 text-sm text-gray-600 grid grid-cols-1 gap-2">
                <div><strong>Team:</strong> <%= link_to work_order.team_name, work_order.volunteers_team, class: 'text-foundationprimarygreen hover:text-forange font-medium' %></div>
                <div><strong>District:</strong> <%= work_order.team_district %></div>
                <div><strong>Assigned by:</strong> <%= work_order.assigned_by_name %></div>
                <div><strong>Date:</strong> <%= work_order.assigned_date.strftime('%B %d, %Y') %></div>
              </div>

              <div class="mt-4 flex items-center justify-between">
                <div><%= days_until_badge(work_order) %></div>
                <div class="text-xs text-gray-500"><%= pluralize(work_order.checklist_items.count, 'task') %></div>
              </div>

              <div class="mt-4 grid grid-cols-2 gap-2">
                <%= link_to 'View Details', work_order, class: 'px-3 py-2 rounded text-sm bg-foundationprimarygreen hover:bg-forange text-white text-center' %>
                <%= link_to 'Edit', edit_work_order_path(work_order), class: 'px-3 py-2 rounded text-sm bg-white border border-foundationprimarygreen text-foundationprimarygreen text-center' %>
                <%= link_to 'View Team', work_order.volunteers_team, class: 'px-3 py-2 rounded text-sm bg-forange hover:bg-forange/90 text-white text-center' %>
                <%= link_to 'Duplicate', new_work_order_path(team_id: work_order.team_id), class: 'px-3 py-2 rounded text-sm bg-white border border-forange text-forange text-center' %>
              </div>

              <div class="mt-4 text-center">
                <%= link_to 'Delete', work_order, method: :delete, data: { confirm: 'Are you sure?' }, class: 'inline-flex items-center px-4 py-2 rounded-md bg-red-500 hover:bg-red-700 text-white text-sm' %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8">
        <p class="text-gray-500">No work orders found.</p>
      </div>
    <% end %>
  </div>
</div>
