<% content_for :title, @project.name.presence || "Showing project" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <!-- Page title (half foundationprimarygreen, half forange) -->
  <div class="mb-6 text-center">
    <% name = @project.name.to_s %>
    <% chars = name.each_char.to_a %>
    <% mid = (chars.length / 2.0).ceil %>
    <% left = chars[0, mid].join %>
    <% right = chars[mid, chars.length].join %>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
      <span class="text-foundationprimarygreen"><%= left %></span><span class="text-forange"><%= right %></span>
    </h1>
    <%# Subtitle: prefer explicit subtitle, then tagline, then a short truncated description %>
    <% subtitle = (@project.respond_to?(:subtitle) && @project.subtitle.present? && @project.subtitle) ||
                  (@project.respond_to?(:tagline) && @project.tagline.present? && @project.tagline) ||
                  truncate(strip_tags(@project.description.to_s), length: 140) %>
    <% if subtitle.present? %>
      <p class="mt-3 text-lg text-gray-600"><%= subtitle.html_safe %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
    <!-- Left: media + long description -->
    <div>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <% if @project.respond_to?(:video_url) && @project.video_url.present? %>
          <div class="aspect-video">
            <iframe class="w-full h-full" src="<%= @project.video_url %>" frameborder="0" allowfullscreen></iframe>
          </div>
        <% elsif @project.image.attached? %>
          <div class="w-full h-96 overflow-hidden">
            <%# Build a safe src: try variant when available, fall back to blob URL on error or when variants unsupported %>
              <% src = safe_image_src(@project.image) rescue nil %>
              <% blob = (url_for(@project.image) rescue nil) %>
              <% if src.present? %>
                <%= tag.img src: src, alt: (@project.name || 'Project image'), loading: 'lazy', class: 'w-full h-full object-cover', onerror: (blob ? "this.onerror=null;this.src='#{blob}';" : nil) %>
              <% elsif blob.present? %>
                <%= tag.img src: blob, alt: (@project.name || 'Project image'), loading: 'lazy', class: 'w-full h-full object-cover' %>
              <% else %>
                <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400">No media available</div>
              <% end %>
          </div>
        <% else %>
          <div class="w-full h-96 bg-gray-100 flex items-center justify-center text-gray-400">No media available</div>
        <% end %>
      </div>

      <div class="mt-6">
        <h2 class="text-2xl font-bold text-gray-900"><%= @project.name %></h2>
        <p class="mt-3 text-gray-700"><%= simple_format(@project.description) %></p>
      </div>
    </div>

    <!-- Right: donation card -->
    <aside class="lg:col-start-2">
      <div id="donation_card" class="bg-white rounded-lg shadow-lg p-6 lg:sticky lg:top-24">
  <h3 class="text-xl font-semibold text-gray-900"><%= @project.donation_title.presence || @project.name %></h3>
  <p class="text-sm text-gray-600 mt-2"><%= @project.donation_subtitle.presence || truncate(strip_tags(@project.description.to_s), length: 160) %></p>

        <div class="mt-4">
          <p class="text-lg font-bold text-gray-900">$<%= @total_donations %> <span class="text-sm font-medium text-gray-500">Raised</span></p>
        
        </div>

        <%= form_with model: Donation.new, url: donations_path, local: true, class: "mt-6 space-y-4" do |f| %>
          <%= f.hidden_field :project_id, value: @project.id %>

          <div>
            <div class="grid grid-cols-3 gap-3">
              <% [50, 150, 250, 500].each do |amt| %>
                <button type="button" data-amount="<%= amt %>" role="button" tabindex="0" aria-pressed="false" class="preset-amount border rounded-md py-3 text-sm font-medium text-gray-700 hover:bg-blue-50">
                  $<%= amt %>
                </button>
              <% end %>
            </div>
          </div>

          <div class="flex gap-2">
            <%= f.number_field :amount, id: "donation_amount", min: 1, placeholder: "Other amount", class: "flex-1 rounded-md border px-3 py-2" %>
        
          </div>

          <div>
            <% if user_signed_in? %>
              <div class="py-2 px-3 bg-gray-50 rounded-md text-sm text-gray-700">
                <div class="font-medium"><%= current_user.first_name %> <%= current_user.last_name %></div>
                <div class="text-xs text-gray-500"><%= current_user.email %></div>
              </div>
            <% else %>
              <%= f.email_field :email, id: "donation_email", placeholder: "Email (required if not signed in)", class: "w-full rounded-md border px-3 py-2" %>
            <% end %>
          </div>

          <div>
            <%= f.submit "DONATE NOW", class: "w-full btn-donate px-4 py-3 font-semibold rounded-md text-white" %>
          </div>
        <% end %>

        <p class="mt-3 text-xs text-gray-500">Your donation will help deliver food, shelter and medicine where it’s most needed.</p>
      </div>
    </aside>
  </div>

  <!-- Tabs and More ways to help -->
  <div class="mt-12">
    <div class="flex items-center gap-4 justify-center">
      <button class="px-4 py-2 rounded-full bg-blue-800 text-white text-sm">LEVEL OF GIVING</button>
      <button class="px-4 py-2 rounded-full border text-sm">DONORS</button>
      <button class="px-4 py-2 rounded-full border text-sm">IMPACT</button>
    </div>

    <h3 class="mt-10 text-center text-xl font-semibold text-gray-800">More ways to help</h3>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% 4.times do |i| %>
        <div class="bg-white rounded-lg shadow p-4">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm text-gray-500">$<%= [100,150,500,500][i] %> USD</p>
              <h4 class="mt-2 font-semibold text-gray-800">Feed <%= [10,3,40,50][i] %> Orphans</h4>
            </div>
            <div class="text-sm text-gray-400"> <%= [1,1,0,28][i] %> Claimed</div>
          </div>
          <p class="mt-3 text-sm text-gray-600">Heartwarming meals prepared with care, including rice, beans, meat, and fresh vegetables.</p>
          <div class="mt-4">
            <button class="w-full bg-pink-500 hover:bg-pink-600 text-white rounded-md px-3 py-2 font-semibold">ADD TO GIVING</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var presets = Array.prototype.slice.call(document.querySelectorAll('.preset-amount'));
    var amountField = document.getElementById('donation_amount');
    var form = amountField ? amountField.closest('form') : null;

    function clearActive() {
      presets.forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
    }

    function setActiveButtonForValue(val) {
      var matched = null;
      presets.forEach(function(b){
        var a = parseFloat(b.getAttribute('data-amount'));
        if(!isNaN(a) && parseFloat(val) === a) matched = b;
      });
      clearActive();
      if(matched) { matched.classList.add('active'); matched.setAttribute('aria-pressed', 'true'); }
    }

    presets.forEach(function(btn){
      // click handler
      btn.addEventListener('click', function(e){
        var a = this.getAttribute('data-amount');
        if(amountField) amountField.value = a;
        clearActive();
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');
        // focus input for accessibility
        if(amountField) amountField.focus();
      });

      // keyboard support (Enter / Space)
      btn.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.click();
        }
      });
    });

    if(amountField) {
      // when user types custom amount, remove active state unless it matches a preset
      amountField.addEventListener('input', function(e){
        var v = this.value ? this.value.toString().trim() : '';
        if(v === '') { clearActive(); return; }
        setActiveButtonForValue(v);
      });

      // initialize state on load
      if(amountField.value) setActiveButtonForValue(amountField.value);
    }

    // if form is reset elsewhere, clear active states
    if(form) {
      form.addEventListener('reset', function(){
        clearActive();
      });
    }
  });
</script>
