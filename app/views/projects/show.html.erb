<% content_for :title, @project.name.presence || "Showing project" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <!-- Page title (half foundationprimarygreen, half forange) -->
  <div class="mb-6 text-center">
    <% name = @project.name.to_s %>
    <% chars = name.each_char.to_a %>
    <% mid = (chars.length / 2.0).ceil %>
    <% left = chars[0, mid].join %>
    <% right = chars[mid, chars.length].join %>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
      <span class="text-foundationprimarygreen"><%= left %></span><span class="text-forange"><%= right %></span>
    </h1>
    <%# Subtitle: prefer explicit subtitle, then tagline, then a short truncated description %>
    <% subtitle = (@project.respond_to?(:subtitle) && @project.subtitle.present? && @project.subtitle) ||
                  (@project.respond_to?(:tagline) && @project.tagline.present? && @project.tagline) ||
                  truncate(strip_tags(@project.description.to_s), length: 140) %>
    <% if subtitle.present? %>
      <p class="mt-3 text-lg text-gray-600"><%= subtitle.html_safe %></p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
    <!-- Left: media + long description -->
    <div>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <% if @project.respond_to?(:video_url) && @project.video_url.present? %>
          <div class="aspect-video">
            <iframe class="w-full h-full" src="<%= @project.video_url %>" frameborder="0" allowfullscreen></iframe>
          </div>
        <% elsif @project.image.attached? %>
          <div class="w-full h-96 overflow-hidden">
            <%# Build a safe src: try variant when available, fall back to blob URL on error or when variants unsupported %>
              <% src = safe_image_src(@project.image) rescue nil %>
              <% blob = (url_for(@project.image) rescue nil) %>
              <% if src.present? %>
                <%= tag.img src: src, alt: (@project.name || 'Project image'), loading: 'lazy', class: 'w-full h-full object-cover', onerror: (blob ? "this.onerror=null;this.src='#{blob}';" : nil) %>
              <% elsif blob.present? %>
                <%= tag.img src: blob, alt: (@project.name || 'Project image'), loading: 'lazy', class: 'w-full h-full object-cover' %>
              <% else %>
                <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400">No media available</div>
              <% end %>
          </div>
        <% else %>
          <div class="w-full h-96 bg-gray-100 flex items-center justify-center text-gray-400">No media available</div>
        <% end %>
      </div>

      <div class="mt-6">
        <h2 class="text-2xl font-bold text-gray-900"><%= @project.name %></h2>
        <p class="mt-3 text-gray-700"><%= simple_format(@project.description) %></p>
      </div>
    </div>

    <!-- Right: donation card -->
    <aside class="lg:col-start-2">
      <div id="donation_card" class="lg:sticky lg:top-24">
        <div class="rounded-lg overflow-hidden shadow-lg">
          <!-- Header -->
          <div class="p-4 bg-foundationprimarygreen">
            <h3 class="text-2xl font-bold text-white"><%= @project.donation_title.presence || @project.name %></h3>
            <p class="mt-1 text-sm text-white/90"><%= @project.donation_subtitle.presence || truncate(strip_tags(@project.description.to_s), length: 120) %></p>
          </div>

          <!-- Body -->
          <div class="p-6 bg-white">
            <div class="flex items-baseline justify-between">
              <div>
                <p class="text-sm text-gray-500">Raised so far</p>
                <p class="text-2xl font-extrabold text-gray-900">$<%= @total_donations %></p>
              </div>
              <% if @project.respond_to?(:goal_amount) && @project.goal_amount.present? && @project.goal_amount.to_f > 0 %>
                <% percent = [( (@total_donations.to_f / @project.goal_amount.to_f) * 100 ).round, 100].min %>
                <div class="text-right">
                  <p class="text-sm text-gray-500">Goal: $<%= number_with_precision(@project.goal_amount, precision: 0) %></p>
                  <p class="text-sm text-gray-500"> <%= percent %>%</p>
                </div>
              <% end %>
            </div>

            <% if @project.respond_to?(:goal_amount) && @project.goal_amount.present? && @project.goal_amount.to_f > 0 %>
              <div class="mt-4">
                <div class="w-full bg-gray-200 rounded h-2 overflow-hidden">
                  <div style="width: <%= percent %>%" class="h-2 bg-forange"></div>
                </div>
              </div>
            <% end %>

            <!-- Preset amounts -->
            <div class="mt-5">
              <div class="grid grid-cols-3 gap-3">
                <% [50, 150, 250, 500].each do |amt| %>
                  <button type="button" data-amount="<%= amt %>" role="button" tabindex="0" aria-pressed="false" class="preset-amount border rounded-md py-3 text-sm font-medium text-gray-700 hover:bg-forange/10">
                    $<%= amt %>
                  </button>
                <% end %>
              </div>
            </div>

            <%= form_with model: Donation.new, url: donations_path, local: true, html: { id: 'donation_form' }, class: "mt-5 space-y-4" do |f| %>
              <%= f.hidden_field :project_id, value: @project.id %>

              <div>
                <!-- Other amount input (user-entered) -->
                <%= f.number_field :amount, id: 'donation_amount', placeholder: 'Other amount', min: 1, step: 1, class: 'w-full rounded-md border px-3 py-2' %>
              </div>

              <div>
                <% if user_signed_in? %>
                  <div class="py-2 px-3 bg-gray-50 rounded-md text-sm text-gray-700">
                    <div class="font-medium"><%= current_user.first_name %> <%= current_user.last_name %></div>
                    <div class="text-xs text-gray-500"><%= current_user.email %></div>
                  </div>
                <% else %>
                  <%= f.email_field :email, id: "donation_email", placeholder: "Email (required if not signed in)", class: "w-full rounded-md border px-3 py-2" %>
                <% end %>
              </div>
 
              <!-- Payment method selection -->
              <div>
                <p class="text-sm font-medium text-gray-700">Payment method</p>
                <div class="mt-2 flex gap-3">
                  <label class="inline-flex items-center gap-2">
                    <%= f.radio_button :payment_method, 'online', checked: true, class: 'payment-method-radio accent-forange' %>
                    <span class="text-sm text-forange">Online payment</span>
                  </label>

                  <label class="inline-flex items-center gap-2">
                    <%= f.radio_button :payment_method, 'manual_transaction', class: 'payment-method-radio accent-forange' %>
                    <span class="text-sm text-forange">Manual (transaction id)</span>
                  </label>

                  <% if user_signed_in? && current_user.role == 'admin' %>
                    <label class="inline-flex items-center gap-2">
                      <%= f.radio_button :payment_method, 'manual_cash', class: 'payment-method-radio accent-forange' %>
                      <span class="text-sm text-forange">Cash (manual - admin)</span>
                    </label>
                  <% end %>
                </div>

                <div id="transaction_wrap" class="hidden mt-2">
                  <%= f.text_field :transaction_id, id: 'donation_transaction_id', placeholder: 'Transaction ID (if applicable)', class: 'w-full rounded-md border px-3 py-2' %>
                </div>

                <%= f.hidden_field :manual, value: false, id: 'donation_manual_flag' %>
              </div>
              <div>
                <%= f.submit "DONATE NOW", class: "w-full btn-donate px-4 py-3 font-semibold rounded-md text-white" %>
              </div>
            <% end %>

            <p class="mt-3 text-xs text-gray-500">Your donation will help deliver food, shelter and medicine where it’s most needed.</p>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <!-- Tabs and More ways to help (carousel) -->
  <div class="mt-12">
    <div class="flex items-center gap-4 justify-center" role="tablist">
      <button data-tab-target="#tab-level" class="tab-button px-4 py-2 rounded-full bg-forange text-white text-sm" role="tab" aria-controls="tab-level" aria-selected="true">LEVEL OF GIVING</button>
      <button data-tab-target="#tab-donors" class="tab-button px-4 py-2 rounded-full border border-foundationprimarygreen text-foundationprimarygreen text-sm" role="tab" aria-controls="tab-donors">DONORS</button>
      <button data-tab-target="#tab-impact" class="tab-button px-4 py-2 rounded-full border border-foundationprimarygreen text-foundationprimarygreen text-sm" role="tab" aria-controls="tab-impact">IMPACT</button>
    </div>

    <h3 class="mt-10 text-center text-xl font-semibold text-gray-800">More ways to help</h3>

    <div class="mt-6">
      <!-- Tab panels -->
      <div id="tab-level" class="tab-panel">
        <!-- Swiper carousel for small project cards -->
        <div class="donationSwiper swiper">
          <div class="swiper-wrapper">
            <% if @more_projects.present? %>
              <% @more_projects.each do |mp| %>
                <div class="swiper-slide">
                  <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <% suggested = if mp.respond_to?(:goal_amount) && mp.goal_amount.present? && mp.goal_amount.to_f > 0
                          [(mp.goal_amount.to_f / 10).round, 50].max
                        else
                          100
                        end %>
                        <p class="text-sm text-gray-500">$<%= suggested %> USD</p>
                        <h4 class="mt-2 font-semibold text-gray-800"><%= truncate(mp.name, length: 40) %></h4>
                      </div>
                      <div class="text-sm text-gray-400"> <%= mp.donations.count %> Claimed</div>
                    </div>
                    <p class="mt-3 text-sm text-gray-600"><%= truncate(strip_tags(mp.description.to_s), length: 100) %></p>
                    <div class="mt-4">
                      <button type="button" class="w-full add-to-giving btn-primary text-white rounded-md px-3 py-2 font-semibold" data-amount="<%= suggested %>">ADD TO GIVING</button>
                    </div>
                  </div>
                </div>
              <% end %>
            <% else %>
              <% 4.times do |i| %>
                <div class="swiper-slide">
                  <div class="bg-white rounded-lg shadow p-4">
                    <div class="flex items-start justify-between">
                      <div>
                        <p class="text-sm text-gray-500">$<%= [100,150,500,500][i] %> USD</p>
                        <h4 class="mt-2 font-semibold text-gray-800">Feed <%= [10,3,40,50][i] %> Orphans</h4>
                      </div>
                      <div class="text-sm text-gray-400"> <%= [1,1,0,28][i] %> Claimed</div>
                    </div>
                    <p class="mt-3 text-sm text-gray-600">Heartwarming meals prepared with care, including rice, beans, meat, and fresh vegetables.</p>
                    <div class="mt-4">
                      <button type="button" class="w-full add-to-giving bg-forange hover:brightness-90 text-white rounded-md px-3 py-2 font-semibold" data-amount="<%= [100,150,500,500][i] %>">ADD TO GIVING</button>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
          <div class="swiper-pagination !bottom-0"></div>
          <button class="swiper-button-prev custom-swiper-btn !left-0" aria-label="Previous">
            <i class="fas fa-chevron-left text-xl" aria-hidden="true"></i>
          </button>
          <button class="swiper-button-next custom-swiper-btn !right-0" aria-label="Next">
            <i class="fas fa-chevron-right text-xl" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <div id="tab-donors" class="tab-panel hidden">
        <div class="max-w-6xl mx-auto">
          <% if @recent_donors.present? %>
            <div class="donors-row mt-4 flex gap-4 overflow-x-auto py-2 px-2 -mx-2">
              <% @recent_donors.each do |d| %>
                <div class="donor-card bg-white rounded-md p-4 shadow-sm flex-shrink-0 min-w-[220px]">
                  <div class="flex items-start justify-between">
                    <div>
                      <div class="text-sm font-medium text-gray-800"><%= d.user.present? ? ([d.user.first_name, d.user.last_name].compact.join(' ')) : (d.email || 'Anonymous') %></div>
                      <div class="text-xs text-gray-500 mt-1"><%= number_to_currency(d.amount, unit: '$') %></div>
                      <div class="text-xs text-gray-400"><%= time_ago_in_words(d.created_at) %> ago</div>
                    </div>
                    <div class="text-sm text-forange font-semibold">Thank you</div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-center text-gray-600">No recent donors yet.</p>
          <% end %>
        </div>
      </div>

      <div id="tab-impact" class="tab-panel hidden">
        <div class="max-w-3xl mx-auto space-y-4">
          <% @impact_items.each do |it| %>
            <div class="bg-white rounded-md p-4 shadow-sm">
              <div class="flex items-start justify-between">
                <div>
                  <h4 class="text-forange font-semibold"><%= it.title %></h4>
                  <p class="text-sm text-gray-600 mt-1"><%= it.summary %></p>
                </div>
                <div class="text-xs text-gray-400"><%= it.created_at.to_date.to_s %></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

