<%= form_with(model: project, local: true, class: "space-y-6") do |form| %>

  <% if project.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(project.errors.count, "error") %> prevented this project from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% project.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="max-w-6xl mx-auto">
    <div class="bg-white rounded-3xl shadow-2xl ring-1 ring-foundationprimarygreen/6 overflow-hidden">
      <div class="bg-foundation-gradient p-6 sm:p-8 backdrop-blur-sm">
        <div class="text-center">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
            <span class="text-foundationprimarygreen"><%= project.persisted? ? "Edit" : "Create" %></span>
            <span class="text-forange"> Project</span>
          </h2>
          <p class="mt-3 text-sm sm:text-base text-gray-700 max-w-2xl mx-auto">Provide project details and optional donation card fields. Keep the description concise — this helps donors decide quickly.</p>
        </div>
      </div>

      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <!-- Main inputs -->
        <div class="md:col-span-8 lg:col-span-8 space-y-6">
          <div>
            <%= form.label :name, class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2 relative">
              <%= form.text_field :name, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": project.errors[:name].none?, "border-red-400 focus:ring-red-500": project.errors[:name].any?}] %>
            </div>
            <p class="mt-2 text-sm text-gray-500">Give the project a concise, descriptive title.</p>
          </div>

          <div>
            <%= form.label :categories, "Category", class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2 relative">
              <%= form.select :categories, options_for_select(Project::CATEGORIES.map { |c| [c, c] }, selected: project.categories), { include_blank: 'Select a category' }, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": project.errors[:categories].none?, "border-red-400 focus:ring-red-500": project.errors[:categories].any?}] %>
            </div>
            <p class="mt-2 text-sm text-gray-500">Choose the best fit category for this project.</p>
          </div>

          <div>
            <%= form.label :description, class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
            <div class="mt-2">
              <%= form.text_area :description, rows: 8, class: ["block w-full rounded-xl shadow-sm sm:text-sm px-4 py-3 border bg-white/60 backdrop-blur-[2px]", {"border-gray-200 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen/40": project.errors[:description].none?, "border-red-400 focus:ring-red-500": project.errors[:description].any?}] %>
            </div>
            <p class="mt-2 text-sm text-gray-500">A short summary shown on listings. Aim for 1–3 short paragraphs.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= form.label :donation_title, "Donation card title", class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.text_field :donation_title, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": project.errors[:donation_title].none?, "border-red-400 focus:ring-red-500": project.errors[:donation_title].any?}] %>
              </div>
            </div>

            <div>
              <%= form.label :donation_subtitle, "Donation card subtitle", class: "block text-xs font-semibold uppercase tracking-wide text-gray-600" %>
              <div class="mt-2">
                <%= form.text_field :donation_subtitle, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": project.errors[:donation_subtitle].none?, "border-red-400 focus:ring-red-500": project.errors[:donation_subtitle].any?}] %>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar: stats & admin controls -->
        <aside class="md:col-span-4 lg:col-span-4 space-y-6">
          <div class="sticky top-20">
            <div class="bg-white rounded-2xl p-4 shadow-lg border border-foundationprimarygreen/5">
              <div class="flex items-start gap-4">
                <div class="flex-1">
                  <div class="text-xs font-semibold text-gray-500">Current Donations</div>
                  <div class="mt-1 text-3xl font-extrabold text-foundationprimarygreen">৳<%= number_with_delimiter(project.total_donations.to_i) rescue '0' %></div>
                  <div class="text-xs text-gray-500 mt-1">Donors: <span class="font-semibold text-gray-700"><%= project.donation_count.to_i rescue 0 %></span></div>
                </div>
                <div class="ml-2 flex-shrink-0 bg-foundationprimarygreen/10 rounded-full p-2">
                  <svg class="w-6 h-6 text-foundationprimarygreen/90" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3"/></svg>
                </div>
              </div>
            </div>

            <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4">
              <div class="text-sm font-medium text-gray-800">Visibility</div>
              <div class="mt-2 text-sm text-gray-600">
                <p>Active: <span class="font-medium <%= project.is_active ? 'text-foundationprimarygreen' : 'text-gray-600' %>"><%= project.is_active ? 'Yes' : 'No' %></span></p>
              </div>
            </div>

            <div class="mt-4 bg-white rounded-lg p-4 border border-gray-100">
              <div class="text-sm font-medium text-foundationprimarygreen">Media & Settings</div>
              <div class="mt-3 space-y-3">
                <div>
                  <%= form.label :image, class: "block text-xs font-medium text-gray-700" %>
                  <%= form.file_field :image, accept: "image/*", class: "mt-1 block w-full text-sm text-gray-600 file:border-0 file:bg-forange/10 file:text-forange file:px-3 file:py-2 rounded-md" %>
                  <% if project.image.attached? %>
                    <div class="mt-3 flex items-center gap-3">
                      <div class="w-24 h-16 bg-gray-100 rounded overflow-hidden flex items-center justify-center">
                        <%= image_tag project.image.variant(resize_to_limit: [240, 160]), class: "object-cover w-full h-full" %>
                      </div>
                      <div class="text-left text-sm">
                        <div class="font-medium text-gray-900">Current image</div>
                        <div class="text-gray-500">Uploaded <%= time_ago_in_words(project.image.blob.created_at) %> ago</div>
                      </div>
                    </div>
                  <% end %>
                </div>

                <div>
                  <div class="flex items-center justify-between p-3 border border-foundationprimarygreen/10 rounded-md bg-foundationprimarygreen/3">
                    <div class="flex items-center gap-3">
                      <%= form.check_box :is_active, class: "h-4 w-4 text-foundationprimarygreen rounded border-gray-300 focus:ring-foundationprimarygreen" %>
                      <div>
                        <%= form.label :is_active, class: "text-sm font-medium text-foundationprimarygreen" %>
                        <p class="text-xs text-gray-500">Mark the project as active to make it visible.</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <!-- Actions -->
      <div class="mt-6">
        <div class="flex flex-col-reverse sm:flex-row items-center sm:justify-end gap-3">
          <%= link_to 'Cancel', projects_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-3 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
          <%= form.submit project.persisted? ? 'Update Project' : 'Create Project', class: "w-full sm:w-auto inline-flex justify-center items-center px-6 py-3 rounded-full text-sm text-white font-semibold shadow-lg btn-primary hover:scale-[1.02] transition-transform duration-150" %>
        </div>
        <p class="mt-3 text-xs text-gray-500 text-center sm:text-right">By submitting you confirm all details are accurate. Admins can update visibility and settings later.</p>
      </div>
    </div>
    </div>
  </div>
<% end %>
