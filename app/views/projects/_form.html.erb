<%= form_with(model: project, local: true, class: "space-y-6") do |form| %>

  <% if project.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(project.errors.count, "error") %> prevented this project from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% project.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-lg p-6">
    <div class="mb-4">
    <h2 class="text-4xl text-center font-bold">
      <span class="text-foundationprimarygreen"><%= project.persisted? ? "Edit" : "Create"%></span>
      <span class="text-forange">Project</span>
    </h2>
  </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left: Main inputs -->
      <div class="lg:col-span-2 space-y-4">
        <div>
          <%= form.label :name, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_field :name, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": project.errors[:name].none?, "border-red-400 focus:ring-red-500": project.errors[:name].any?}] %>
          </div>
          <% if project.errors[:name].any? %>
            <p class="mt-1 text-sm text-red-600"><%= project.errors[:name].first %></p>
          <% else %>
            <p class="mt-1 text-sm text-gray-400">Give the project a concise, descriptive title.</p>
          <% end %>
        </div>

        <div>
          <%= form.label :categories, "Category", class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.select :categories, options_for_select(Project::CATEGORIES.map { |c| [c, c] }, selected: project.categories), { include_blank: 'Select a category' }, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border bg-white", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": project.errors[:categories].none?, "border-red-400 focus:ring-red-500": project.errors[:categories].any?}] %>
          </div>
          <p class="mt-1 text-sm text-gray-500">Choose the best fit category for this project.</p>
        </div>

        <div>
          <%= form.label :description, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.textarea :description, rows: 6, class: ["block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": project.errors[:description].none?, "border-red-400 focus:ring-red-500": project.errors[:description].any?}] %>
          </div>
          <p class="mt-1 text-sm text-gray-500">A short summary shown on listings. Aim for 1–3 short paragraphs.</p>
        </div>
      </div>

      <!-- Right: Image & flags -->
      <div class="space-y-4">
        <div class="border border-dashed border-forange/20 rounded-md p-4 flex flex-col items-center text-center bg-forange/5">
          <p class="text-sm font-medium text-foundationprimarygreen">Project image</p>
          <p class="text-xs text-forange mt-1">Recommended: 800×600px. JPG or PNG.</p>
          <div class="mt-3 w-full">
            <%= form.file_field :image, accept: "image/*", class: ["block w-full text-sm text-gray-600 file:border-0 file:bg-forange/10 file:text-forange file:px-3 file:py-2 rounded-md", {"border-foundationprimarygreen/20": project.errors[:image].none?, "border-red-400": project.errors[:image].any?}] %>
            <% if project.image.attached? %>
              <div class="mt-3 flex items-center gap-3">
                <div class="w-24 h-16 bg-gray-100 rounded overflow-hidden flex items-center justify-center">
                  <%= image_tag project.image.variant(resize_to_limit: [240, 160]), class: "object-cover w-full h-full" %>
                </div>
                <div class="text-left text-sm">
                  <div class="font-medium text-gray-900">Current image</div>
                  <div class="text-gray-500">Uploaded <%= time_ago_in_words(project.image.blob.created_at) %> ago</div>
                </div>
              </div>
            <% end %>
          </div>
          <% if project.errors[:image].any? %>
            <p class="mt-2 text-sm text-red-600"><%= project.errors[:image].first %></p>
          <% end %>
        </div>

        <div class="flex items-center justify-between p-3 border border-foundationprimarygreen/10 rounded-md bg-foundationprimarygreen/3">
          <div class="flex items-center gap-3">
            <%= form.check_box :is_active, class: "h-4 w-4 text-foundationprimarygreen rounded border-gray-300 focus:ring-foundationprimarygreen" %>
            <div>
              <%= form.label :is_active, class: "text-sm font-medium text-foundationprimarygreen" %>
              <p class="text-xs text-gray-500">Mark the project as active to make it visible.</p>
            </div>
          </div>
        </div>

        <div class="hidden lg:block"></div>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-3">
      <%= link_to 'Cancel', projects_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
      <%= form.submit class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 rounded-md bg-foundationprimarygreen hover:bg-foundationprimarygreen/80 text-sm text-white font-medium shadow-md" %>
    </div>
  </div>
<% end %>
