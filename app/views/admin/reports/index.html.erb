<div class="max-w-6xl mx-auto py-8">
  <h1 class="text-2xl font-bold">Financial Reports</h1>

  <div class="mt-4 bg-white p-4 rounded shadow">
    <form method="get" action="<%= admin_reports_path %>" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <div>
        <label class="text-sm">Start date</label>
        <input type="date" name="start_date" value="<%= params[:start_date] %>" class="w-full rounded border px-2 py-1" />
      </div>
      <div>
        <label class="text-sm">End date</label>
        <input type="date" name="end_date" value="<%= params[:end_date] %>" class="w-full rounded border px-2 py-1" />
      </div>
      <div>
        <label class="text-sm">Project</label>
        <select name="project_id" class="w-full rounded border px-2 py-1">
          <option value="">All projects</option>
          <% Project.order(:name).each do |p| %>
            <option value="<%= p.id %>" <%= 'selected' if params[:project_id].to_s == p.id.to_s %>><%= p.name %></option>
          <% end %>
        </select>
      </div>
      <div class="flex items-end gap-2">
        <button class="btn-primary px-4 py-2">Filter</button>
        <a href="<%= admin_reports_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date], project_id: params[:project_id]) %>" class="btn-secondary px-4 py-2">Download CSV</a>
      </div>
    </form>
  </div>

  <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-4 rounded shadow">
      <h2 class="text-lg font-semibold">Donations (<%= number_to_currency(@donations_total || 0) %>)</h2>
      <table class="w-full mt-3 text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500">
            <th>Date</th>
            <th>Project</th>
            <th>Donor</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @donations.each do |d| %>
            <tr>
              <td class="py-2"><%= d.created_at.to_date %></td>
              <td><%= d.project&.name %></td>
              <td><%= d.user&.email || d.email || 'Guest' %></td>
              <td class="text-right"><%= number_to_currency(d.amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="mt-3"><%= paginate @donations %></div>
    </div>

    <div class="bg-white p-4 rounded shadow">
      <h2 class="text-lg font-semibold">Expenses (<%= number_to_currency(@expenses_total || 0) %>)</h2>
      <table class="w-full mt-3 text-sm">
        <thead>
          <tr class="text-left text-xs text-gray-500">
            <th>Date</th>
            <th>Project</th>
            <th>Title</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% @expenses.each do |e| %>
            <tr>
              <td class="py-2"><%= e.expense_date %></td>
              <td><%= e.project&.name %></td>
              <td><%= e.title %></td>
              <td class="text-right"><%= number_to_currency(e.amount) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="mt-3"><%= paginate @expenses, param_name: :exp_page %></div>
    </div>
  </div>

  <div class="mt-6 bg-white p-4 rounded shadow">
    <h3 class="text-lg font-semibold">Balance</h3>
    <p class="mt-2">Donations total: <strong><%= number_to_currency(@donations_total || 0) %></strong></p>
    <p>Expenses total: <strong><%= number_to_currency(@expenses_total || 0) %></strong></p>
    <p class="mt-2 text-xl">Net balance: <strong><%= number_to_currency(@balance || 0) %></strong></p>
  </div>
</div>
