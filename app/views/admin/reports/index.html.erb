<div class="max-w-6xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between gap-4 mb-4">
    <h1 class="text-2xl sm:text-3xl font-bold">Financial Reports</h1>
    <div class="hidden sm:flex items-center gap-3">
      <a href="<%= admin_reports_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date], project_id: params[:project_id]) %>" class="btn-secondary px-4 py-2">Download CSV</a>
    </div>
  </div>

  <!-- Mobile summary cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
    <div class="bg-white p-3 rounded-lg shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs text-gray-500">Donations</div>
        <div class="text-lg font-semibold text-foundationprimarygreen"><%= number_to_currency(@donations_total || 0) %></div>
      </div>
      <div class="text-forange text-2xl"><i class="fas fa-hand-holding-heart" aria-hidden="true"></i></div>
    </div>

    <div class="bg-white p-3 rounded-lg shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs text-gray-500">Expenses</div>
        <div class="text-lg font-semibold text-red-600"><%= number_to_currency(@expenses_total || 0) %></div>
      </div>
      <div class="text-red-500 text-2xl"><i class="fas fa-receipt" aria-hidden="true"></i></div>
    </div>

    <div class="bg-white p-3 rounded-lg shadow-sm flex items-center justify-between">
      <div>
        <div class="text-xs text-gray-500">Net</div>
        <div class="text-lg font-semibold <%= (@balance || 0) >= 0 ? 'text-foundationprimarygreen' : 'text-red-600' %>"><%= number_to_currency(@balance || 0) %></div>
      </div>
      <div class="text-foundationprimarygreen text-2xl"><i class="fas fa-balance-scale" aria-hidden="true"></i></div>
    </div>
  </div>

  <!-- Filters -->
  <div class="mb-6 bg-white p-4 rounded-lg shadow">
    <form method="get" action="<%= admin_reports_path %>" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <div>
        <label class="text-sm text-gray-600">Start date</label>
        <input type="date" name="start_date" value="<%= params[:start_date] %>" class="w-full rounded border px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-sm text-gray-600">End date</label>
        <input type="date" name="end_date" value="<%= params[:end_date] %>" class="w-full rounded border px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-sm text-gray-600">Project</label>
        <select name="project_id" class="w-full rounded border px-3 py-2 text-sm">
          <option value="">All projects</option>
          <% Project.order(:name).each do |p| %>
            <option value="<%= p.id %>" <%= 'selected' if params[:project_id].to_s == p.id.to_s %>><%= p.name %></option>
          <% end %>
        </select>
      </div>
      <div class="flex items-end gap-2">
        <button class="btn-primary w-full sm:w-auto px-4 py-2">Filter</button>
        <a href="<%= admin_reports_path %>" class="inline-block text-sm text-gray-600 border rounded px-4 py-2 hover:bg-gray-50">Clear</a>
        <a href="<%= admin_reports_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date], project_id: params[:project_id]) %>" class="btn-secondary hidden sm:inline-block px-4 py-2">Download CSV</a>
      </div>
    </form>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white p-4 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-2">Donations</h2>
      <div class="text-sm text-gray-500 mb-2">Total: <span class="font-medium"><%= number_to_currency(@donations_total || 0) %></span></div>
      <div class="overflow-x-auto">
        <table class="min-w-[680px] w-full divide-y text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500">
              <th class="px-2 py-2">Date</th>
              <th class="px-2 py-2">Project</th>
              <th class="px-2 py-2">Donor</th>
              <th class="px-2 py-2 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @donations.each do |d| %>
              <tr>
                <td class="px-2 py-3"><%= d.created_at.to_date %></td>
                <td class="px-2 py-3">
                  <%# Donations may be regular Donation (has project) or HealthcareDonation (linked via healthcare_request) %>
                  <% project_name = if d.respond_to?(:project) && d.project.present?
                                      d.project&.name
                                    elsif d.respond_to?(:healthcare_request) && d.healthcare_request&.respond_to?(:project)
                                      d.healthcare_request&.project&.name
                                    end %>
                  <%= project_name || '-' %>
                </td>
                <td class="px-2 py-3"><%= d.user&.email || d.email || 'Guest' %></td>
                <td class="px-2 py-3 text-right font-medium"><%= number_to_currency(d.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3"><%= paginate @donations %></div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-2">Expenses</h2>
      <div class="text-sm text-gray-500 mb-2">Total: <span class="font-medium"><%= number_to_currency(@expenses_total || 0) %></span></div>
      <div class="overflow-x-auto">
        <table class="min-w-[680px] w-full divide-y text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500">
              <th class="px-2 py-2">Date</th>
              <th class="px-2 py-2">Project</th>
              <th class="px-2 py-2">Title</th>
              <th class="px-2 py-2 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @expenses.each do |e| %>
              <tr>
                <td class="px-2 py-3"><%= e.expense_date %></td>
                <td class="px-2 py-3">
                  <%# Expenses may be regular Expense (has project) or HealthcareExpense (linked via healthcare_request) %>
                  <% exp_project_name = if e.respond_to?(:project) && e.project.present?
                                           e.project&.name
                                         elsif e.respond_to?(:healthcare_request) && e.healthcare_request&.respond_to?(:project)
                                           e.healthcare_request&.project&.name
                                         end %>
                  <%= exp_project_name || '-' %>
                </td>
                <td class="px-2 py-3"><%= e.title %></td>
                <td class="px-2 py-3 text-right font-medium"><%= number_to_currency(e.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3"><%= paginate @expenses, param_name: :exp_page %></div>
    </div>
  </div>

  <div class="mt-6 bg-white p-4 rounded-lg shadow">
    <h3 class="text-lg font-semibold">Balance</h3>
    <div class="mt-2 grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div>
        <div class="text-xs text-gray-500">Donations total</div>
        <div class="font-medium"><%= number_to_currency(@donations_total || 0) %></div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Expenses total</div>
        <div class="font-medium text-red-600"><%= number_to_currency(@expenses_total || 0) %></div>
      </div>
      <div>
        <div class="text-xs text-gray-500">Net balance</div>
        <div class="text-xl font-semibold <%= (@balance || 0) >= 0 ? 'text-foundationprimarygreen' : 'text-red-600' %>"><%= number_to_currency(@balance || 0) %></div>
      </div>
    </div>
  </div>
</div>
