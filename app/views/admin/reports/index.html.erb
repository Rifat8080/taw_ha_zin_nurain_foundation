<div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold">Financial Reports</h1>
      <div class="text-sm text-gray-500">Detailed view of donations and expenses (including healthcare)</div>
    </div>
    <div class="flex items-center gap-3">
      <a href="<%= admin_reports_path(format: :csv, start_date: params[:start_date], end_date: params[:end_date], project_id: params[:project_id]) %>" class="btn-secondary px-4 py-2">Download CSV</a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Donations total</div>
      <div class="text-xl font-semibold text-foundationprimarygreen"><%= number_to_currency(@donations_total || 0) %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Expenses total</div>
      <div class="text-xl font-semibold text-red-600"><%= number_to_currency(@expenses_total || 0) %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Net balance</div>
      <div class="text-xl font-semibold <%= (@balance || 0) >= 0 ? 'text-foundationprimarygreen' : 'text-red-600' %>"><%= number_to_currency(@balance || 0) %></div>
    </div>
  </div>

  <!-- Filters -->
  <div class="mb-6 bg-white p-4 rounded-lg shadow">
  <form method="get" action="<%= admin_reports_path %>" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div>
        <label class="text-sm text-gray-600">Start date</label>
        <input type="date" name="start_date" value="<%= params[:start_date] %>" class="w-full rounded border px-3 py-2 text-sm" />
      </div>
      <div>
        <label class="text-sm text-gray-600">End date</label>
        <input type="date" name="end_date" value="<%= params[:end_date] %>" class="w-full rounded border px-3 py-2 text-sm" />
      </div>
  <!-- removed combined Projects + Healthcare requests dropdown per request -->
      <div class="flex items-end gap-2">
        <button class="btn-primary w-full sm:w-auto px-4 py-2">Filter</button>
        <a href="<%= admin_reports_path %>" class="inline-block text-sm text-gray-600 border rounded px-4 py-2 hover:bg-gray-50">Clear</a>
      </div>
    </form>
  </div>

  <!-- combined filter script removed -->

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Donations detailed list -->
    <section class="bg-white p-4 rounded-lg shadow">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold">Donations (Projects + Healthcare)</h2>
        <div class="text-sm text-gray-500">Showing <%= @donations.total_count if @donations.respond_to?(:total_count) %> items</div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full w-full divide-y text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500">
              <th class="px-2 py-2">Source</th>
              <th class="px-2 py-2">Project / Request</th>
              <th class="px-2 py-2">Donor</th>
              <th class="px-2 py-2">Method</th>
              <th class="px-2 py-2 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @donations.each do |d| %>
              <% if d.respond_to?(:project_id) && d.project_id.present? %>
                <% source = 'project' %>
                <% project_or_request = d.project&.name || '-' %>
                <% method = d.respond_to?(:payment_method) ? d.payment_method : (d.respond_to?(:currency) ? d.currency : '') %>
              <% else %>
                <% source = 'healthcare' %>
                <% project_or_request = d.respond_to?(:healthcare_request) ? (d.healthcare_request&.patient_name || 'Healthcare request') : 'Healthcare request' %>
                <% method = d.respond_to?(:payment_method) ? d.payment_method : '' %>
              <% end %>
              <tr class="hover:bg-gray-50">
                <td class="px-2 py-3 text-xs text-gray-600"><%= source == 'project' ? 'Project' : 'Healthcare' %></td>
                <td class="px-2 py-3"><%= project_or_request %></td>
                <td class="px-2 py-3"><%= d.user&.email || (d.respond_to?(:email) ? d.email : 'Guest') %></td>
                <td class="px-2 py-3 text-sm text-gray-600"><%= method.presence || '-' %></td>
                <td class="px-2 py-3 text-right font-medium"><%= number_to_currency(d.amount) %></td>
              </tr>
              <%# expanded healthcare detail row removed to avoid showing patient/request info inline %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-3"><%= paginate @donations %></div>
    </section>

    <!-- Expenses detailed list -->
    <section class="bg-white p-4 rounded-lg shadow">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold">Expenses (Projects + Healthcare)</h2>
        <div class="text-sm text-gray-500">Showing <%= @expenses.total_count if @expenses.respond_to?(:total_count) %> items</div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full w-full divide-y text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-500">
              <th class="px-2 py-2">Source</th>
              <th class="px-2 py-2">Project / Request</th>
              <th class="px-2 py-2">Title</th>
              <th class="px-2 py-2 text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <% @expenses.each do |e| %>
              <% if e.respond_to?(:project_id) && e.project_id.present? %>
                <% source = 'project' %>
                <% project_or_request = e.project&.name || '-' %>
              <% else %>
                <% source = 'healthcare' %>
                <% project_or_request = e.respond_to?(:healthcare_request) ? (e.healthcare_request&.patient_name || 'Healthcare request') : 'Healthcare request' %>
              <% end %>
              <tr class="hover:bg-gray-50">
                <td class="px-2 py-3 text-xs text-gray-600"><%= source == 'project' ? 'Project' : 'Healthcare' %></td>
                <td class="px-2 py-3"><%= project_or_request %></td>
                <td class="px-2 py-3"><%= e.title || e.description || '-' %></td>
                <td class="px-2 py-3 text-right font-medium"><%= number_to_currency(e.amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-3"><%= paginate @expenses, param_name: :exp_page %></div>
    </section>
  </div>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Donations total</div>
      <div class="font-medium"><%= number_to_currency(@donations_total || 0) %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Expenses total</div>
      <div class="font-medium text-red-600"><%= number_to_currency(@expenses_total || 0) %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-xs text-gray-500">Net balance</div>
      <div class="text-xl font-semibold <%= (@balance || 0) >= 0 ? 'text-foundationprimarygreen' : 'text-red-600' %>"><%= number_to_currency(@balance || 0) %></div>
    </div>
  </div>
</div>
