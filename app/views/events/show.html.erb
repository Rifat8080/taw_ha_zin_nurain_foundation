<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="lg:grid lg:grid-cols-12 lg:gap-x-8">
    <!-- Event Image -->
    <div class="lg:col-span-5">
      <% if @event.event_image.attached? %>
        <div class="aspect-w-4 aspect-h-3 rounded-lg overflow-hidden">
          <%= image_tag @event.event_image, class: "w-full h-full object-center object-cover" %>
        </div>
      <% else %>
        <div class="aspect-w-4 aspect-h-3 rounded-lg overflow-hidden bg-gray-200 flex items-center justify-center">
          <span class="text-gray-400">No Image Available</span>
        </div>
      <% end %>
    </div>

    <!-- Event Details -->
    <div class="mt-8 lg:mt-0 lg:col-span-7">
      <div class="flex items-start justify-between gap-6">
        <div class="flex-1">
          <h1 class="text-3xl md:text-4xl font-extrabold text-foundationprimarygreen leading-tight"><%= @event.name %></h1>
          <% if @event.respond_to?(:subtitle) && @event.subtitle.present? %>
            <p class="mt-2 text-sm text-gray-600"><%= @event.subtitle %></p>
          <% end %>
        </div>
        <div>
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold shadow-sm
            <%= @event.event_status == 'upcoming' ? 'bg-foundationprimarygreen/10 text-foundationprimarygreen' : 
                @event.event_status == 'active' ? 'bg-forange/10 text-forange' : 
                'bg-gray-100 text-gray-800' %>">
            <%= @event.event_status.capitalize %>
          </span>
        </div>
      </div>

    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
      <h3 class="text-sm font-medium text-foundationprimarygreen">Event Details</h3>
          <dl class="mt-2 space-y-1">
            <div class="flex items-start gap-3">
              <div class="mt-1 text-foundationprimarygreen">
                <!-- calendar icon -->
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Date</dt>
                <dd class="text-sm text-gray-900">
                  <%= @event.start_date.strftime("%B %d, %Y") %>
                  <% if @event.start_date != @event.end_date %>
                    - <%= @event.end_date.strftime("%B %d, %Y") %>
                  <% end %>
                </dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 text-forange">
                <!-- clock icon -->
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Time</dt>
                <dd class="text-sm text-gray-900">
                  <%= @event.start_time.strftime("%I:%M %p") %> - <%= @event.end_time.strftime("%I:%M %p") %>
                </dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 text-gray-500">
                <!-- map pin icon -->
                <svg class="h-5 w-5 text-foundationprimarygreen" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c1.657 0 3-1.567 3-3.5S13.657 4 12 4 9 5.567 9 7.5 10.343 11 12 11z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s8-4.5 8-10.5S16.418 2 12 2 4 6.5 4 10.5 12 21 12 21z"/></svg>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Venue</dt>
                <dd class="text-sm text-gray-900"><%= @event.venue %></dd>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="mt-1 text-gray-400">
                <!-- tag/category icon -->
                <svg class="h-5 w-5 text-forange" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M3 7a4 4 0 014-4h4l6 6v4a4 4 0 01-4 4H7a4 4 0 01-4-4V7z"/></svg>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Category</dt>
                <dd class="text-sm text-gray-900"><%= @event.ticket_category.capitalize %></dd>
              </div>
            </div>
          </dl>
        </div>

        <div>
          <h3 class="text-sm font-medium text-foundationprimarygreen">Ticket Types</h3>
          <% if @event.ticket_types.any? %>
            <div class="mt-3 space-y-3">
              <% @event.available_ticket_types.each do |ticket_type| %>
                <div class="rounded-xl p-4 bg-white shadow-md hover:shadow-lg transition transform-gpu hover:-translate-y-1">
                  <div class="flex justify-between items-start gap-4">
                    <div class="flex-1">
                      <h4 class="text-sm font-semibold text-gray-900"><%= ticket_type['name'] %></h4>
                      <p class="text-xs text-gray-500 uppercase tracking-wide"><%= ticket_type['category'] %></p>
                      <% if ticket_type['description'].present? %>
                        <p class="text-xs text-gray-600 mt-1"><%= ticket_type['description'] %></p>
                      <% end %>
                    </div>
                    <div class="text-right ml-4 flex flex-col items-end gap-2">
                      <div class="text-2xl font-extrabold text-forange">$<%= ticket_type['price'] %></div>
                      <div class="text-xs <%= ticket_type['sold_out'] ? 'text-red-600' : 'text-foundationprimarygreen' %>">
                        <%= ticket_type['seats_remaining'] %> / <%= ticket_type['seats_available'] %> available
                      </div>
                      <% unless ticket_type['sold_out'] %>
                        <%= form_with model: [@event, @event.tickets.build], local: true, class: "inline-block mt-1" do |form| %>
                          <%= form.hidden_field :ticket_type, value: ticket_type['category'] %>
                          <%= form.submit "Buy 1", class: "px-3 py-2 rounded-md btn-primary bg-forange text-white text-sm font-semibold shadow-sm hover:brightness-95" %>
                        <% end %>
                      <% else %>
                        <span class="text-xs text-red-600 font-medium">Sold out</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <!-- Legacy display for old events -->
            <dl class="mt-2 space-y-1">
              <div>
                <dt class="text-sm text-gray-500">Price:</dt>
                <dd class="text-2xl font-bold text-gray-900">$<%= @event.ticket_price %></dd>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Total Seats:</dt>
                <dd class="text-sm text-gray-900"><%= @event.total_seats %></dd>
              </div>
              <div>
                <dt class="text-sm text-gray-500">Available:</dt>
                <dd class="text-sm text-gray-900 <%= @event.sold_out? ? 'text-red-600' : 'text-green-600' %>">
                  <%= @event.available_seats %> seats
                </dd>
              </div>
            </dl>
          <% end %>
        </div>
      </div>

      <!-- Description -->
      <% if @event.guest_description.present? %>
        <div class="mt-8">
          <h3 class="text-lg font-medium text-gray-900">About the Event</h3>
          <div class="mt-2 prose prose-sm text-gray-500">
            <%= simple_format(@event.guest_description) %>
          </div>
        </div>
      <% end %>

      <!-- Guest Information -->
      <% if @event.guests.any? %>
        <div class="mt-8">
          <h3 class="text-lg font-medium text-gray-900">Event Guests</h3>
          <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @event.guests.each do |guest| %>
              <div class="bg-white border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                <% if guest.image.attached? %>
                  <div class="w-16 h-16 mx-auto mb-3">
                    <%= image_tag guest.image, class: "w-full h-full object-cover rounded-full" %>
                  </div>
                <% else %>
                  <div class="w-16 h-16 mx-auto mb-3 bg-gray-100 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </div>
                <% end %>
                
                <div class="text-center">
                  <h4 class="font-medium text-forange"><%= guest.name %></h4>
                  <% if guest.title.present? %>
                    <p class="text-sm text-foundationprimarygreen font-bold mt-1"><%= guest.title %></p>
                  <% end %>
                  <% if guest.description.present? %>
                    <p class="text-sm mt-2 line-clamp-3"><%= guest.description %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @event.guest_list.present? %>
        <div class="mt-8">
          <h3 class="text-lg font-medium text-gray-900">Special Guests</h3>
          <div class="mt-2 prose prose-sm text-gray-500">
            <%= simple_format(@event.guest_list) %>
          </div>
        </div>
      <% end %>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col gap-4">
        <% if @event.event_status == 'past' %>
          <!-- Event has passed - show message instead of ticket buttons -->
          <div class="bg-gray-50 border border-gray-300 rounded-lg p-4">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <h3 class="text-lg font-medium text-gray-900">Event Has Ended</h3>
                <p class="text-sm text-gray-600 mt-1">
                  This event ended on <%= @event.end_date.strftime("%B %d, %Y") %>. 
                  Ticket booking is no longer available.
                </p>
              </div>
            </div>
          </div>
        <% elsif @event.sold_out? %>
          <div id="purchase" class="space-y-3">
            <h3 class="text-lg font-medium text-gray-900">Purchase Tickets</h3>
            <button disabled class="w-full flex justify-center py-3 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-500 bg-gray-100 cursor-not-allowed">
              Sold Out
            </button>
          </div>
        <% else %>
          <div id="purchase" class="space-y-3">
            <h3 class="text-lg font-medium text-gray-900">Purchase Tickets</h3>
            
            <!-- New Bulk Purchase Button -->
            <button type="button" 
                    onclick="openTicketModal()"
                    class="w-full flex justify-center items-center btn-primary py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
              Purchase Multiple Tickets
            </button>
            
            <!-- Individual ticket type options (kept for quick single purchases) -->
            <% if @event.ticket_types.any? %>
              <div class="text-center text-sm text-gray-500 py-2">
                or buy individual tickets:
              </div>
              <!-- Multiple ticket types -->
              <% @event.available_ticket_types.each do |ticket_type| %>
                <% unless ticket_type['sold_out'] %>
                  <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 transition-colors">
                    <div class="flex justify-between items-center">
                      <div>
                        <h4 class="text-sm font-medium text-gray-900"><%= ticket_type['name'] %></h4>
                        <p class="text-xs text-gray-500"><%= ticket_type['description'] if ticket_type['description'].present? %></p>
                        <p class="text-sm text-gray-600 mt-1">
                          <%= ticket_type['seats_remaining'] %> seats remaining
                        </p>
                      </div>
                      <div class="text-right">
                        <div class="text-lg font-bold text-gray-900 mb-2">$<%= ticket_type['price'] %></div>
                        <%= form_with model: [@event, @event.tickets.build], local: true, class: "inline-block" do |form| %>
                          <%= form.hidden_field :ticket_type, value: ticket_type['category'] %>
                          <%= form.submit "Buy 1 Ticket", 
                              class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <div class="text-center text-sm text-gray-500 py-2">
                or buy a single ticket:
              </div>
              <!-- Legacy single ticket type -->
              <%= form_with model: [@event, @event.tickets.build], local: true, class: "flex-1" do |form| %>
                <%= form.submit "Buy 1 Ticket - $#{@event.ticket_price}", 
                    class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        
        <% if @event_user %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-3">
            <p class="text-sm text-green-700">
              ✓ You are registered for this event
              <% if @user_tickets.any? %>
                with <%= @user_tickets.count %> ticket(s)
              <% end %>
            </p>
          </div>
        <% end %>
        
        <div class="flex gap-2 mt-4">
          <%= link_to "Edit Event", edit_event_path(@event), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <%= link_to "View Attendees", attendees_event_path(@event), 
              class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      </div>

      <!-- User's Tickets -->
      <% if @user_tickets.any? %>
        <div class="mt-8">
          <h3 class="text-lg font-medium text-gray-900">Your Tickets</h3>
          <div class="mt-4 space-y-4">
            <% @user_tickets.each do |ticket| %>
              <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
                <div>
                  <p class="text-sm font-medium text-gray-900">
                    Ticket #<%= ticket.id.split('-').first %>
                    <% if ticket.seat_number.present? %>
                      - Seat <%= ticket.seat_number %>
                    <% end %>
                  </p>
                  <p class="text-sm text-gray-500">
                    Status: <span class="<%= ticket.status == 'active' ? 'text-green-600' : 'text-gray-600' %>">
                      <%= ticket.status.capitalize %>
                    </span>
                  </p>
                </div>
                <div class="flex gap-2">
                  <%= link_to "View QR Code", ticket_path(ticket), 
                      class: "inline-flex items-center px-3 py-1 border border-gray-300 rounded text-sm text-gray-700 bg-white hover:bg-gray-50" %>
                  <% if ticket.can_be_cancelled? %>
                    <%= link_to "Cancel", ticket_path(ticket), method: :delete, 
                        data: { confirm: "Are you sure you want to cancel this ticket?" },
                        class: "inline-flex items-center px-3 py-1 border border-red-300 rounded text-sm text-red-700 bg-white hover:bg-red-50" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <%= link_to "← Back to Events", events_path, 
        class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" %>
  </div>
</div>

<!-- Bulk Ticket Purchase Modal -->
<%= render 'bulk_ticket_modal' %>
