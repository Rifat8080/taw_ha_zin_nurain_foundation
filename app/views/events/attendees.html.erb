<% content_for :title, "#{@event.name} - Attendees" %>

<div class="max-w-7xl mx-auto sm:px-6 lg:px-8">
  <div class="bg-white overflow-hidden shadow-sm sm:rounded-lg">
    <div class="p-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6 gap-4">
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-foundationprimarygreen"><%= @event.name %> <span class="text-base font-medium text-gray-500">— Attendees</span></h1>
          <p class="text-sm text-gray-600 mt-1">Event Date: <%= @event.start_date.strftime("%B %d, %Y at %I:%M %p") %></p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to "Back to Event", @event, class: "inline-flex items-center gap-2 px-4 py-2 rounded-md border border-[rgba(var(--color-foundationprimarygreen),0.12)] text-sm font-medium text-foundationprimarygreen bg-white hover:bg-foundationprimarygreen/5" %>
        </div>
      </div>

      <!-- Statistics -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
          <div class="p-2 rounded-md bg-foundationprimarygreen/10 text-foundationprimarygreen">
            <!-- ticket icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l2-2 4 4"/></svg>
          </div>
          <div>
            <div class="text-xl font-bold text-gray-900"><%= @event.tickets.count %></div>
            <div class="text-sm text-gray-500">Total Tickets</div>
          </div>
        </div>

        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
          <div class="p-2 rounded-md bg-foundationprimarygreen/10 text-foundationprimarygreen">
            <!-- active icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div>
            <div class="text-xl font-bold text-gray-900"><%= @event.tickets.where(status: 'active').count %></div>
            <div class="text-sm text-gray-500">Active Tickets</div>
          </div>
        </div>

        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
          <div class="p-2 rounded-md bg-forange/10 text-forange">
            <!-- used icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3"/></svg>
          </div>
          <div>
            <div class="text-xl font-bold text-gray-900"><%= @event.tickets.where(status: 'used').count %></div>
            <div class="text-sm text-gray-500">Used Tickets</div>
          </div>
        </div>

        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex items-center gap-3">
          <div class="p-2 rounded-md bg-gray-100 text-gray-600">
            <!-- seats icon -->
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h18M5 7v10a1 1 0 001 1h12a1 1 0 001-1V7"/></svg>
          </div>
          <div>
            <div class="text-xl font-bold text-gray-900"><%= @event.available_seats %></div>
            <div class="text-sm text-gray-500">Available Seats</div>
          </div>
        </div>
      </div>

      <!-- Attendees List -->
      <div class="bg-white shadow overflow-hidden sm:rounded-md">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900">Ticket Holders</h3>
          <p class="mt-1 max-w-2xl text-sm text-gray-500">List of all people who have purchased tickets.</p>
        </div>
        
        <% if @event.tickets.any? %>
          <ul class="divide-y divide-gray-100">
            <% @event.tickets.includes(:user).order(:created_at).each do |ticket| %>
              <li class="px-4 py-4 sm:px-6">
                <div class="flex items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class="h-12 w-12 rounded-full bg-gray-100 flex items-center justify-center text-foundationprimarygreen font-semibold text-sm">
                      <%= ticket.user.full_name.split(' ').map(&:first).join.upcase %>
                    </div>
                    <div>
                      <div class="text-sm font-medium text-gray-900"><%= ticket.user.full_name %></div>
                      <div class="text-sm text-gray-500"><%= ticket.user.email %></div>
                      <div class="text-xs text-gray-400">Purchased: <%= ticket.created_at.strftime("%b %d, %Y %I:%M %p") %></div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <% if ticket.seat_number.present? %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-foundationprimarygreen/10 text-foundationprimarygreen">
                        Seat <%= ticket.seat_number %>
                      </span>
                    <% end %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium <%= ticket.status == 'active' ? 'bg-foundationprimarygreen/10 text-foundationprimarygreen' : ticket.status == 'used' ? 'bg-forange/10 text-forange' : 'bg-gray-100 text-gray-800' %>">
                      <%= ticket.status.humanize %>
                    </span>
                    <span class="text-xs text-gray-500">#<%= ticket.id.split('-').first %></span>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="px-4 py-12 text-center">
            <div class="text-gray-500">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.196-2.121M9 20h8v-2a3 3 0 00-5.196-2.121m1.196 2.121A6.002 6.002 0 003 15a6.002 6.002 0 006 7.28M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">No attendees yet</h3>
              <p class="mt-1 text-sm text-gray-500">No one has purchased tickets for this event yet.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
