<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100">
      <!-- Header -->
      <div class="bg-foundation-gradient px-6 sm:px-8 py-6">
        <div class="flex items-center justify-between">
          <h1 class="text-xl sm:text-2xl font-extrabold text-foundationprimarygreen tracking-tight">Event Ticket</h1>
          <div class="<%= status_badge_class(@ticket.status) %>">
            <%= @ticket.status.capitalize %>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6 sm:p-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Left column: Event info -->
          <div class="lg:col-span-2 space-y-6">
            <h2 class="text-2xl font-extrabold text-gray-900">
              <span class="text-forange">
                <%= @ticket.event.name %>
              </span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
                <h3 class="text-xs font-bold text-gray-500 uppercase">Date & Time</h3>
                <p class="mt-2 text-sm text-gray-900 font-semibold">
                  <%= @ticket.event.start_date.strftime("%B %d, %Y") %>
                  <% if @ticket.event.start_date != @ticket.event.end_date %>
                    - <%= @ticket.event.end_date.strftime("%B %d, %Y") %>
                  <% end %>
                </p>
                <p class="text-sm text-gray-600 mt-1">
                  <%= @ticket.event.start_time.strftime("%I:%M %p") %> - <%= @ticket.event.end_time.strftime("%I:%M %p") %>
                </p>
              </div>

              <div class="p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
                <h3 class="text-xs font-bold text-gray-500 uppercase">Venue</h3>
                <p class="mt-2 text-sm text-gray-900 font-semibold"><%= @ticket.event.venue %></p>
              </div>

              <div class="p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
                <h3 class="text-xs font-bold text-gray-500 uppercase">Ticket Details</h3>
                <div class="mt-2 grid grid-cols-2 gap-2">
                  <div>
                    <p class="text-xs text-gray-500">Type</p>
                    <p class="text-sm font-semibold text-gray-900"><%= @ticket.ticket_type.capitalize %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500">Price</p>
                    <p class="text-sm font-semibold text-gray-900">$<%= @ticket.price %></p>
                  </div>
                </div>
              </div>

              <% if @ticket.seat_number.present? %>
                <div class="p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
                  <h3 class="text-xs font-bold text-gray-500 uppercase">Seat</h3>
                  <p class="mt-2 text-sm font-semibold text-gray-900"><%= @ticket.seat_number %></p>
                </div>
              <% end %>
            </div>

            <!-- Actions -->
            <div class="mt-6 border-t pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div>
                <%= link_to event_path(@ticket.event), class: "inline-flex items-center text-sm text-gray-600 hover:text-gray-800" do %>
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                  Back to Event
                <% end %>
              </div>

              <div class="flex gap-3">
                <% if @ticket.can_be_cancelled? %>
                  <%= button_to ticket_path(@ticket), method: :delete, data: { turbo_confirm: "Are you sure you want to cancel this ticket?" }, class: "px-4 py-2 rounded-md bg-red-600 text-white hover:bg-red-700 text-sm font-semibold" do %>
                    Cancel Ticket
                  <% end %>
                <% end %>

                <button data-action="print-ticket" class="px-4 py-2 rounded-md border border-gray-200 bg-white text-sm hover:bg-gray-50">Print Ticket</button>
              </div>
            </div>
          </div>

          <!-- Right column: QR + copy -->
          <div class="lg:col-span-1">
            <div class="p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
              <h3 class="text-xs font-bold text-gray-500 uppercase mb-4">Digital Entry Pass</h3>

              <div class="flex items-center justify-center">
                <div class="qr-wrapper bg-white p-3 rounded-lg shadow-inner">
                  <div class="qr-inner max-w-[300px] w-full">
                    <% if @ticket.qr_code_svg.present? %>
                      <%= @ticket.qr_code_svg.html_safe %>
                    <% else %>
                      <% begin %>
                        <% require 'rqrcode' unless defined?(RQRCode) %>
                        <% qr = RQRCode::QRCode.new(@ticket.qr_code_data) %>
                        <%= qr.as_svg(offset: 0, color: '000', shape_rendering: 'crispEdges', module_size: 4, standalone: false).html_safe %>
                      <% rescue %>
                        <div class="text-sm text-gray-500">QR unavailable</div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

              <p class="text-sm text-gray-600 text-center mt-4">Present this QR code at the entrance for quick check-in</p>

              <div class="mt-4 flex items-center gap-2">
                <div class="flex-1 text-xs font-mono text-gray-500 bg-gray-50 px-3 py-2 rounded-lg border border-gray-100 truncate">
                  <%= @ticket.qr_code %>
                </div>
                <button data-action="copy-qr" data-qr-code="<%= @ticket.qr_code %>" class="p-2 rounded-lg bg-white border border-gray-200 hover:bg-gray-50 focus:outline-none" title="Copy QR">
                  <i class="fa-regular fa-copy text-gray-700 w-4 h-4" aria-hidden="true"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .qr-wrapper { overflow: hidden; }
    .qr-inner svg { width: 100% !important; height: auto !important; display:block !important; }
    @media (min-width: 1024px) { .qr-inner { max-width: 420px; } }
  </style>

  
</div>
