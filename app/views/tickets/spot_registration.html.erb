<% content_for :title, "Spot Registration" %>
<div class="container mx-auto px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 p-4 bg-forange/10 border-l-4 border-forange rounded-r-lg shadow-sm flex items-center" id="notice">
      <svg class="h-5 w-5 text-forange mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span class="text-forange font-medium"><%= notice %></span>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow border border-foundationprimarygreen/20 overflow-hidden">
    <div class="px-6 py-6 md:flex md:items-center md:justify-between bg-foundationprimarygreen text-white">
      <div class="w-full text-center">
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
          <span class="text-white">Volunteer</span>
          <span class="text-forange"> Booth</span>
          <span class="text-white"> Registration</span>
        </h1>
        <p class="mt-2 text-lg md:text-xl text-foundationprimarygreen/10">On-site ticket registration for walk-in attendees</p>
      </div>
      <div class="mt-4 md:mt-0 flex items-center gap-3">
        <div class="text-sm text-white">
          <div class="font-medium">Volunteer: <%= current_user.full_name %></div>
          <div class="text-xs opacity-90">ID: <%= current_user.id.split('-').first %> • Authorized</div>
        </div>
      </div>
    </div>

    <div class="p-6">
      <%= form_with model: @spot_registration, url: create_spot_registration_tickets_path, local: true, class: "space-y-6" do |form| %>

        <% if @spot_registration.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-md p-4" role="alert" aria-live="assertive">
            <div class="flex">
              <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">Please correct the following errors:</h3>
                <ul class="mt-2 text-sm text-red-700 list-disc pl-5">
                  <% @spot_registration.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Main form -->
          <div class="lg:col-span-2 space-y-6">
            <div class="bg-gray-50 p-4 rounded-lg hover:shadow-lg transition-shadow duration-200">
              <h3 class="text-lg font-medium text-gray-900 mb-3">Event</h3>
              <div>
                <%= form.label :event_id, "Select Event", class: "block text-sm font-medium text-gray-700" %>
                <%= form.select :event_id,
                    options_from_collection_for_select(@events, :id, :name, @spot_registration.event_id),
                    { prompt: "Choose an event..." },
                    {
                      id: 'spot_registration_event_id',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      required: true
                    } %>
                <% if @events.any? %>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="text-sm font-medium text-gray-600 mr-2">Quick select:</span>
                    <% @events.first(6).each do |ev| %>
                      <button type="button" data-event-id="<%= ev.id %>" class="event-chip inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-700 hover:bg-forange/10 hover:text-forange border border-transparent transition-colors"> <%= ev.name.truncate(24) %> </button>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="bg-gray-50 p-4 rounded-lg hover:shadow-lg transition-shadow duration-200">
              <h3 class="text-lg font-medium text-gray-900 mb-3">Attendee Information</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <%= form.label :first_name, "First Name", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_field :first_name, id: 'spot_registration_first_name',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      placeholder: "John",
                      required: true,
                      autocomplete: 'given-name' %>
                </div>

                <div>
                  <%= form.label :last_name, "Last Name", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_field :last_name, id: 'spot_registration_last_name',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      placeholder: "Doe",
                      required: true,
                      autocomplete: 'family-name' %>
                </div>

                <div>
                  <%= form.label :email, "Email Address", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.email_field :email, id: 'spot_registration_email',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      placeholder: "john.doe@example.com",
                      required: true,
                      autocomplete: 'email' %>
                </div>

                <div>
                  <%= form.label :phone_number, "Phone Number", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.telephone_field :phone_number, id: 'spot_registration_phone_number',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      placeholder: "(555) 123-4567",
                      required: true,
                      autocomplete: 'tel' %>
                </div>

                <div class="md:col-span-2">
                  <%= form.label :address, "Address (Optional)", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.text_area :address, rows: 2,
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      placeholder: "123 Main St, City, State, ZIP" %>
                </div>
              </div>
            </div>

            <div class="bg-gray-50 p-4 rounded-lg hover:shadow-lg transition-shadow duration-200">
              <h3 class="text-lg font-medium text-gray-900 mb-3">Ticket</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <%= form.label :ticket_type, "Ticket Type", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.select :ticket_type, [
                      ['General Admission', 'general'],
                      ['VIP', 'vip'],
                      ['Premium', 'premium'],
                      ['Standard', 'standard']
                    ], { prompt: "Select ticket type..." }, { id: 'spot_registration_ticket_type', class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm", required: true } %>
                </div>

                <div>
                  <%= form.label :quantity, "Number of Tickets", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.number_field :quantity, id: 'spot_registration_quantity',
                      class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-forange focus:border-forange sm:text-sm",
                      min: 1, max: 10, value: @spot_registration.quantity || 1, required: true %>
                </div>
              </div>
            </div>
          </div>

          <!-- Sidebar / Instructions + Actions -->
          <aside class="space-y-6">
            <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 hover:shadow-sm transition-shadow duration-150">
              <h4 class="text-sm font-medium text-yellow-800">Registration Instructions</h4>
              <ul class="mt-2 text-sm text-yellow-700 list-disc pl-5 space-y-1">
                <li>Verify attendee information before submitting</li>
                <li>Existing accounts will be linked automatically</li>
                <li>New attendees receive a temporary password via email</li>
                <li>Tickets include QR codes for entry</li>
                <li>Collect payment per event pricing (if applicable)</li>
              </ul>
            </div>

            <div class="bg-gray-50 p-4 rounded-md border border-gray-100">
              <div class="flex flex-col gap-3">
                <%= link_to "Cancel", root_path, class: "w-full inline-flex items-center justify-center px-6 py-3 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-forange hover:text-white transition-colors duration-200" %>
                <%= form.submit "Register Attendee", class: "w-full inline-flex items-center justify-center px-6 py-3 btn-primary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200 bg-foundationprimarygreen" %>
              </div>
            </div>
          </aside>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Bind behavior on Turbo/DOMContentLoaded for robust event attachment
function initSpotRegistration() {
  const phone = document.getElementById('spot_registration_phone_number');
  const firstName = document.getElementById('spot_registration_first_name');
  const lastName = document.getElementById('spot_registration_last_name');
  const eventSelect = document.getElementById('spot_registration_event_id');

  if (phone) {
    phone.addEventListener('input', function(e) {
      let value = e.target.value.replace(/\D/g, '');
      if (value.length >= 6) {
        value = value.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
      } else if (value.length >= 3) {
        value = value.replace(/(\d{3})(\d{0,3})/, '($1) $2');
      }
      e.target.value = value;
    });
  }

  if (firstName) {
    firstName.addEventListener('input', function(e) { e.target.value = e.target.value.replace(/\b\w/g, l => l.toUpperCase()); });
  }
  if (lastName) {
    lastName.addEventListener('input', function(e) { e.target.value = e.target.value.replace(/\b\w/g, l => l.toUpperCase()); });
  }

  // Placeholder for dynamic ticket fetching when event changes
  if (eventSelect) {
    eventSelect.addEventListener('change', function() {
      // Example: implement fetch(`/events/${this.value}/ticket_types`) to update ticket type select
      // For now, this keeps static options.
    });

    // Wire up quick-select chips
    document.querySelectorAll('.event-chip').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const id = this.getAttribute('data-event-id');
        if (!id) return;
        eventSelect.value = id;
        eventSelect.dispatchEvent(new Event('change', { bubbles: true }));
        // make selected chip visually active
        document.querySelectorAll('.event-chip').forEach(c => c.classList.remove('bg-forange/10','text-forange','border-forange'));
        this.classList.add('bg-forange/10','text-forange');
      });
    });
  }
}

document.addEventListener('turbo:load', initSpotRegistration);
document.addEventListener('DOMContentLoaded', initSpotRegistration);
</script>
