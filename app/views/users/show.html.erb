<% content_for :title, "Showing user" %>

<div class="md:w-3/4 w-full px-8 py-8 lg:px-12 mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-foundationprimarygreen/10 mb-5 text-foundationprimarygreen font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <header class="flex items-center justify-between mb-6">
    <h1 class="font-extrabold text-4xl text-forange">Profile</h1>
    <div class="text-right">
      <p class="text-sm text-gray-500">Member since <%= @user.created_at.strftime('%b %d, %Y') rescue '—' %></p>
    </div>
  </header>

  <div class="bg-foundation-gradient p-6 rounded-xl shadow-xl">
    <div class="bg-white rounded-lg shadow-md overflow-hidden border border-foundationprimarygreen/10 p-6">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <div class="w-36 h-36 rounded-full overflow-hidden bg-foundationprimarygreen/5 ring-4 ring-foundationprimarygreen/10">
            <% if @user.avatar.attached? && @user.avatar.blob.persisted? %>
              <%= image_tag url_for(@user.avatar), class: "object-cover w-full h-full" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-foundationprimarygreen/5 text-foundationprimarygreen">
                <span class="text-4xl font-bold"><%= @user.first_name.to_s.first || '?' %></span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex-1">
          <h2 class="text-2xl font-semibold text-gray-900"><%= [@user.first_name, @user.last_name].compact.join(' ') %></h2>
          <p class="mt-1 text-sm text-gray-600"><%= @user.email %></p>

          <div class="mt-4 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-foundationprimarygreen/10 text-foundationprimarygreen text-sm font-medium">Role: <span class="ml-2 font-semibold"><%= @user.role %></span></span>
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-forange/10 text-forange text-sm font-medium">Phone: <span class="ml-2 font-semibold text-forange"><%= @user.phone_number.presence || '—' %></span></span>
          </div>

          <div class="mt-6 text-sm text-gray-700">
            <h3 class="text-sm text-gray-500 mb-1">Address</h3>
            <p class="text-base"><%= @user.address.presence || 'No address provided' %></p>
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex gap-2">
          <%= link_to 'Edit', edit_user_path(@user), class: "inline-flex items-center px-4 py-2 bg-foundationprimarygreen hover:bg-foundationprimarygreen/80 text-white font-medium rounded-lg shadow" %>
          <%= button_to 'Delete', @user, method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: "inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg shadow" %>
        </div>

        <div class="flex gap-2">
          <%= link_to 'Back to users', users_path, class: "inline-flex items-center px-4 py-2 border border-foundationprimarygreen/20 text-foundationprimarygreen rounded-lg hover:bg-foundationprimarygreen/5" %>
        </div>
      </div>
    </div>
  </div>
</div>