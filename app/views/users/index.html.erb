<div class="container mx-auto px-8 py-10">
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-8 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight">Our <span class="text-forange">Users</span></h1>
      <p class="mt-2 text-lg text-gray-700">Manage admin and member users. Volunteers are managed separately.</p>
    </div>

    <div class="flex-shrink-0">
      <%= link_to new_user_registration_path, class: "inline-flex items-center whitespace-nowrap px-6 py-3 bg-foundationprimarygreen hover:bg-forange text-white font-semibold rounded-lg shadow-lg" do %>
        <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
        New User
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <div class="mb-6">
      <%= form_with url: users_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
        <div class="flex-1">
          <%= form.text_field :q, placeholder: "Search users by name, email, or role...",
              value: params[:q],
              class: "w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500" %>
        </div>
        <div class="flex gap-2">
          <%= form.submit "Search", class: "px-6 py-3 btn-primary text-white font-semibold rounded-lg transition-all duration-200 transform will-change-transform hover:scale-105 hover:shadow-xl" %>
          <% if params[:q].present? %>
            <%= link_to "Clear", users_path, class: "px-6 py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg transition-colors" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% # small set of decorative gradient presets; we pick one per-user deterministically %>
      <% pattern_gradients = [
        'bg-gradient-to-br from-forange to-foundationprimarygreen',
        'bg-gradient-to-br from-foundationprimarygreen to-forange',
        'bg-gradient-to-br from-yellow-300 to-pink-300',
        'bg-gradient-to-br from-blue-50 to-indigo-100'
      ] %>
      <% @users.each do |user| %>
        <% gradient = pattern_gradients[user.id.hash.abs % pattern_gradients.size] %>
  <div data-user-card class="relative bg-white rounded-3xl shadow-lg p-6 text-center transition-transform transform hover:-translate-y-3 hover:shadow-2xl border border-foundationprimarygreen/10">
          <%# decorative background: gradient + subtle dot pattern (low opacity, pointer-events-none) %>
          <div class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none z-0" aria-hidden="true">
            <div class="w-full h-full <%= gradient %> opacity-25"></div>
            <svg class="absolute inset-0 w-full h-full opacity-25" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 100 100">
              <defs>
                <pattern id="dots-<%= user.id %>" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="1" cy="1" r="0.9" fill="rgba(255,255,255,0.85)" />
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill="url(#dots-<%= user.id %>)" />
            </svg>
          </div>
          <div class="relative z-10">
            <div class="absolute top-4 right-4">
            <button data-user-card-menu-button class="text-gray-400 hover:text-gray-700 focus:outline-none p-2 rounded-full hover:bg-gray-100" aria-label="Open user menu">
              <i class="fa-solid fa-ellipsis-vertical"></i>
            </button>
            <div data-user-card-menu class="hidden mt-2 w-40 bg-white border rounded-md shadow-lg text-left overflow-hidden">
              <%= link_to 'Show', user, class: 'block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50' %>
              <%= link_to 'Edit', edit_user_path(user), class: 'block px-3 py-2 text-sm text-foundationprimarygreen hover:bg-forange/10' %>
              <%= link_to 'Delete', user, method: :delete, data: { confirm: 'Are you sure?' }, class: 'block px-3 py-2 text-sm text-red-600 hover:bg-red-50' %>
            </div>
          </div>

          <div class="flex flex-col items-center">
            <div class="w-32 h-32 rounded-full p-2 mb-4 bg-gradient-to-br from-forange to-foundationprimarygreen inline-flex items-center justify-center shadow-md">
              <% if user.respond_to?(:avatar) && user.avatar.attached? %>
                <%= image_tag url_for(user.avatar), class: 'w-28 h-28 rounded-full object-cover border-4 border-white' %>
              <% else %>
                <div class="w-28 h-28 rounded-full bg-white flex items-center justify-center text-3xl font-extrabold text-foundationprimarygreen">
                  <%= user.first_name.to_s.first.to_s.upcase %>
                </div>
              <% end %>
            </div>

            <h3 class="text-xl md:text-2xl font-extrabold text-gray-900"><%= [user.first_name, user.last_name].compact.join(' ') %></h3>
            <div class="mt-3">
              <span class="inline-flex items-center px-4 py-1 rounded-full text-sm font-semibold bg-forange/20 text-forange border border-forange/30"><%= user.role %></span>
            </div>
            <p class="mt-3 text-sm text-gray-600 font-medium truncate w-full"><%= user.email %></p>
          </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>