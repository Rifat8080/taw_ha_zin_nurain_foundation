<%= form_with(model: user, local: true, class: "space-y-6") do |form| %>

  <% if user.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(user.errors.count, "error") %> prevented this user from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-lg p-6">
    <div class="mb-4">
      <h2 class="text-4xl text-center font-bold">
        <span class="text-foundationprimarygreen"><%= user.persisted? ? "Edit" : "Create"%></span>
        <span class="text-forange"> User</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-4">
        <div>
          <%= form.label :first_name, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_field :first_name, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:first_name].none?, "border-red-400 focus:ring-red-500": user.errors[:first_name].any?}] %>
          </div>
        </div>

        <div>
          <%= form.label :last_name, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_field :last_name, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:last_name].none?, "border-red-400 focus:ring-red-500": user.errors[:last_name].any?}] %>
          </div>
        </div>

        <div>
          <%= form.label :email, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.email_field :email, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:email].none?, "border-red-400 focus:ring-red-500": user.errors[:email].any?}] %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= form.label :phone_number, class: "block text-sm font-medium text-foundationprimarygreen" %>
            <div class="mt-1">
              <%= form.telephone_field :phone_number, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:phone_number].none?, "border-red-400 focus:ring-red-500": user.errors[:phone_number].any?}] %>
            </div>
          </div>

          <div>
            <%= form.label :role, class: "block text-sm font-medium text-foundationprimarygreen" %>
            <div class="mt-1">
              <% role_options = ['admin', 'member', 'volunteer'] %>
              <%= form.select :role, options_for_select(role_options, selected: user.role), { include_blank: 'Select a role' }, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border bg-white", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:role].none?, "border-red-400 focus:ring-red-500": user.errors[:role].any?}] %>
            </div>
          </div>
        </div>

        <div>
          <%= form.label :address, class: "block text-sm font-medium text-foundationprimarygreen" %>
          <div class="mt-1">
            <%= form.text_area :address, rows: 3, class: ["block w-full rounded-md sm:text-sm px-3 py-2 border", {"border-gray-300 focus:border-foundationprimarygreen focus:ring-foundationprimarygreen": user.errors[:address].none?, "border-red-400 focus:ring-red-500": user.errors[:address].any?}] %>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <div class="border border-dashed border-forange/20 rounded-md p-4 flex flex-col items-center text-center bg-forange/5">
          <p class="text-sm font-medium text-foundationprimarygreen">Profile photo</p>
          <p class="text-xs text-forange mt-1">Optional - upload a profile image</p>
          <div class="mt-3 w-full">
            <%= form.file_field :avatar, accept: 'image/*', class: "block w-full text-sm text-gray-600 file:border-0 file:bg-forange/10 file:text-forange file:px-3 file:py-2 rounded-md" %>
          </div>
        </div>

        <div class="border border-foundationprimarygreen/10 rounded-md p-4 bg-foundationprimarygreen/3 text-sm text-gray-700">
          <p class="font-medium text-foundationprimarygreen">Account options</p>
          <p class="mt-1">You can change the user's role and contact details here.</p>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-3">
          <%= link_to 'Cancel', users_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
          <%= form.submit user.persisted? ? 'Update User' : 'Create User', class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 rounded-md text-sm text-white font-medium shadow-md btn-primary" %>
        </div>
      </div>
    </div>
  </div>

<% end %>

