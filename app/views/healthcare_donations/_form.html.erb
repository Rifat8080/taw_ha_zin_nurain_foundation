<%= form_with model: [(@healthcare_request if defined?(@healthcare_request)), @healthcare_donation].compact, local: true do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :amount, t('.amount_label', default: 'Amount'), class: 'block text-sm font-medium text-gray-700' %>
      <div class="mt-1 relative rounded-md shadow-sm">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">৳</span>
        <%= f.number_field :amount, step: 0.01, min: 0.01, class: 'block w-full pl-8 pr-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-foundationprimarygreen' %>
      </div>
    </div>

    <div class="flex justify-end">
      <%= f.submit t('.donate_button', default: 'Donate'), class: 'inline-flex items-center px-4 py-2 bg-[rgb(var(--color-forange))] text-white rounded-md font-semibold hover:bg-yellow-500' %>
    </div>
  </div>
<% end %>
