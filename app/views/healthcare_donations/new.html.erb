<% content_for(:title, "Make Healthcare Donation") %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Form column -->
    <section class="lg:col-span-7">
      <div class="bg-white rounded-2xl shadow-xl border border-foundationprimarygreen/10 overflow-hidden">
        <div class="relative bg-foundation-gradient p-6 sm:p-8">
            <!-- dark overlay to ensure text contrast over the gradient -->
            <h2 class="relative z-10 text-3xl sm:text-4xl font-extrabold drop-shadow">
              <span class="text-foundationprimarygreen">Donate</span>
              <span class="text-forange"> Now</span>
            </h2>
            <p class="relative z-10 mt-2 text-base sm:text-lg text-foundationprimarygreen">Support patients in need — choose a quick amount or enter a custom donation. Secure payments and instant receipts.</p>
          </div>

        <div class="p-6 sm:p-8">
          <%= form_with model: [@healthcare_request, @healthcare_donation], local: true, class: "space-y-6" do |form| %>
            <% if @healthcare_donation.errors.any? %>
              <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
                <div class="flex items-start gap-3">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                  <div>
                    <p class="text-sm font-semibold">Please correct the following errors:</p>
                    <ul class="mt-2 text-sm list-disc list-inside">
                      <% @healthcare_donation.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Quick amounts -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-3">Quick Select Amount</label>
              <div class="flex flex-wrap gap-3">
                <% [500,1000,2000,5000,10000,20000].each do |amt| %>
                  <button type="button" data-amount="<%= amt %>" aria-pressed="false" tabindex="0" role="button" class="amount-btn inline-flex items-center justify-center px-4 py-2 rounded-xl border border-foundationprimarygreen/10 text-sm font-semibold text-gray-800 bg-white hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-foundationprimarygreen/20 transition">৳<%= number_with_delimiter(amt) %></button>
                <% end %>
              </div>
            </div>

            <!-- Custom amount -->
            <div>
              <div class="flex items-center justify-between">
                <%= form.label :amount, "Custom Amount (৳)", class: "block text-sm font-medium text-gray-700" %>
                <span class="text-xs text-gray-500">Minimum ৳1</span>
              </div>
              <div class="mt-2">
                <%= form.number_field :amount, id: "donation_amount", min: 1, step: 1, class: "block w-full rounded-2xl shadow-sm border border-gray-200 px-4 py-3 text-xl font-semibold focus:outline-none focus:ring-foundationprimarygreen/40 focus:border-foundationprimarygreen", placeholder: "Enter amount in Taka", required: true %>
              </div>
            </div>

            <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
              <p class="text-sm text-gray-700">Your donation will directly support this patient's medical treatment. Donations are recorded and final.</p>
            </div>

            <div class="flex items-center justify-end gap-3">
              <%= link_to "Cancel", healthcare_request_path(@healthcare_request), class: "px-5 py-2 rounded-md text-sm font-medium border border-gray-200 bg-white text-gray-700 hover:bg-gray-50" %>
              <%= form.submit "Donate Now", class: "px-6 py-3 rounded-full text-sm font-semibold text-white shadow-lg btn-primary hover:brightness-95" %>
            </div>
          <% end %>
        </div>
      </div>
    </section>

    <!-- Summary column -->
    <aside class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Patient Information</h3>
        <div class="space-y-3 text-sm text-gray-700">
          <div>
            <div class="text-xs text-gray-500">Patient Name</div>
            <div class="text-gray-900 font-medium"><%= @healthcare_request.patient_name %></div>
          </div>
          <div>
            <div class="text-xs text-gray-500">Medical Condition</div>
            <div class="text-gray-900 line-clamp-4"><%= truncate(@healthcare_request.reason, length: 200) %></div>
          </div>
          <div>
            <div class="text-xs text-gray-500">Requested by</div>
            <div class="text-gray-900"><%= @healthcare_request.user.full_name %></div>
          </div>
          <% if @healthcare_request.prescription_url.present? %>
            <div>
              <div class="text-xs text-gray-500">Medical Documents</div>
              <%= link_to "View Prescription", @healthcare_request.prescription_url, target: "_blank", class: "text-foundationprimarygreen hover:underline text-sm" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Current Donations</h3>
        <div class="space-y-3 text-sm text-gray-700">
          <div class="flex justify-between">
            <span class="text-gray-600">Total Raised:</span>
            <span class="font-bold text-foundationprimarygreen text-lg">৳<%= number_with_delimiter(@healthcare_request.total_donations) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Number of Donors:</span>
            <span class="font-semibold"><%= @healthcare_request.donation_count %></span>
          </div>
          <% if @healthcare_request.donation_count > 0 %>
            <div class="flex justify-between">
              <span class="text-gray-600">Average Donation:</span>
              <span class="font-semibold">৳<%= number_with_delimiter((@healthcare_request.total_donations / @healthcare_request.donation_count).round) %></span>
            </div>
          <% end %>
        </div>
      </div>

      <% if @healthcare_request.healthcare_donations.any? %>
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Donors</h3>
          <div class="space-y-3 text-sm">
            <% @healthcare_request.healthcare_donations.includes(:user).recent.limit(5).each do |donation| %>
              <div class="flex justify-between items-center">
                <div class="text-gray-700"><%= donation.user.full_name %></div>
                <div class="font-medium text-foundationprimarygreen">৳<%= number_with_delimiter(donation.amount) %></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </aside>
  </div>
</div>

<script>
  // Quick amount buttons: populate #donation_amount, toggle selected state, clear on manual input.
  (function() {
    function initDonationAmountButtons() {
      const amountInput = document.getElementById('donation_amount');
      if (!amountInput) return;

      const buttons = Array.from(document.querySelectorAll('.amount-btn'));
      if (!buttons.length) return;

      function clearSelection() {
        buttons.forEach(b => {
          b.classList.remove('ring-2','ring-foundationprimarygreen/10','bg-foundationprimarygreen/10','border-foundationprimarygreen','bg-foundationprimarygreen/10','text-white','shadow-md','bg-[rgb(var(--color-foundationprimarygreen))]');
          b.setAttribute('aria-pressed','false');
        });
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', function(e) {
          const amt = this.getAttribute('data-amount');
          if (!amt) return;
          amountInput.value = amt;
          // visual
          clearSelection();
          this.classList.add('ring-2','ring-foundationprimarygreen/30','bg-[rgb(var(--color-foundationprimarygreen))]','border-foundationprimarygreen','text-white','shadow-md');
          this.setAttribute('aria-pressed','true');
          amountInput.dispatchEvent(new Event('input', { bubbles: true }));
        });
        // keyboard support: Enter/Space selects
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.click();
          }
        });
      });

      // If user types a custom amount, clear quick selections
      amountInput.addEventListener('input', function() {
        const val = this.value.replace(/[^0-9]/g, '') || '';
        const match = buttons.find(b => b.getAttribute('data-amount') === val);
        if (!match) clearSelection();
        else {
          clearSelection();
          match.classList.add('ring-2','ring-foundationprimarygreen/30','bg-[rgb(var(--color-foundationprimarygreen))]','border-foundationprimarygreen','text-white','shadow-md');
          match.setAttribute('aria-pressed','true');
        }
      });

      // Pre-select if input has a value on load
      if (amountInput.value) {
        const current = buttons.find(b => b.getAttribute('data-amount') === amountInput.value);
        if (current) {
          clearSelection();
          current.classList.add('ring-2','ring-foundationprimarygreen/30','bg-[rgb(var(--color-foundationprimarygreen))]','border-foundationprimarygreen','text-white','shadow-md');
          current.setAttribute('aria-pressed','true');
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDonationAmountButtons);
      document.addEventListener('turbo:load', initDonationAmountButtons);
    } else {
      initDonationAmountButtons();
    }
  })();
</script>
