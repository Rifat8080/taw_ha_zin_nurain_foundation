<% content_for :title, t('.donation_details_title', default: 'Donation Details') %>
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow p-6">
    <h2 class="text-2xl font-bold mb-2">Donation</h2>
    <div class="text-sm text-gray-600 mb-4">Donated on <%= @healthcare_donation.created_at.strftime('%B %d, %Y') %></div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
      <div>
        <div class="text-xs text-gray-500">Patient</div>
        <div class="font-semibold"><%= link_to @healthcare_donation.healthcare_request.patient_name, healthcare_request_path(@healthcare_donation.healthcare_request), class: 'text-foundationprimarygreen' %></div>
        <div class="text-sm text-gray-600"><%= truncate(@healthcare_donation.healthcare_request.reason, length: 140) %></div>
      </div>
      <div class="text-right">
        <div class="text-xs text-gray-500">Amount</div>
        <div class="text-2xl font-bold text-green-600">৳<%= number_with_delimiter(@healthcare_donation.amount) %></div>
        <div class="text-sm text-gray-500 mt-2">Donor: <%= @healthcare_donation.user.full_name %></div>
      </div>
    </div>

    <div class="mt-4">
      <%= link_to 'Back to My Donations', healthcare_donations_path, class: 'inline-flex px-4 py-2 border rounded-md' %>
      <%= link_to 'View Request', healthcare_request_path(@healthcare_donation.healthcare_request), class: 'inline-flex ml-2 px-4 py-2 bg-foundationprimarygreen text-white rounded-md' %>
    </div>
  </div>
</div>
