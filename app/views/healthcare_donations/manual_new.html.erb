<% content_for :title, 'Create Manual Donation' %>
<div class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-4">Create Manual Healthcare Donation</h1>

  <%= form_with model: @healthcare_donation, url: manual_create_healthcare_donations_path, local: true do |f| %>
    <div class="grid grid-cols-1 gap-4">
      <div>
        <%= f.label :request_id, 'Healthcare Request', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.collection_select :request_id, @healthcare_requests, :id, :patient_name, prompt: 'Select a request', class: 'mt-1 block w-full rounded-md border-gray-300' %>
      </div>

      <div>
        <%= f.label :user_id, 'Donor (User)', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.collection_select :user_id, @users, :id, :email, prompt: 'Select a user', class: 'mt-1 block w-full rounded-md border-gray-300' %>
      </div>

      <div>
        <%= f.label :amount, 'Amount (৳)', class: 'block text-sm font-medium text-gray-700' %>
        <%= f.number_field :amount, step: 1, min: 1, class: 'mt-1 block w-full rounded-md border-gray-300' %>
      </div>

      <div class="flex gap-2">
        <%= f.submit 'Create Donation', class: 'px-4 py-2 bg-foundationprimarygreen text-white rounded-md' %>
        <%= link_to 'Cancel', healthcare_donations_path, class: 'px-4 py-2 border rounded-md text-gray-700' %>
      </div>
    </div>
  <% end %>
</div>
