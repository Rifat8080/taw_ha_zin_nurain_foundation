<% content_for :title, "Manual Donations" %>
<div class="container mx-auto px-8 py-8">
  <% if notice.present? %>
    <div class="mb-6 p-4 bg-forange/10 border-l-4 border-forange rounded-r-lg shadow-sm flex items-center" id="notice">
      <svg class="h-5 w-5 text-forange mr-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
      </svg>
      <span class="text-forange font-medium"><%= notice %></span>
    </div>
  <% end %>

  <!-- Header -->
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-8 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">
        Manual <span class="text-forange">Donations</span>
      </h1>
      <p class="mt-2 text-lg text-gray-700 text-center">Manage manually-created healthcare donations for requests.</p>
    </div>
  </div>

  <!-- Search & Filters -->
  <div class="mb-8 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <%= form_with url: healthcare_donations_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
      <div class="flex-1 md:flex md:items-center md:gap-3">
        <div class="flex-1">
          <%= form.text_field :search, placeholder: "Search by donor, patient, or request...", value: params[:search], class: "w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500" %>
        </div>
        <div class="mt-3 md:mt-0 md:w-64">
          <%= form.label :request_id, 'Filter by Request', class: 'sr-only' %>
          <%= form.select :request_id, options_from_collection_for_select(@requests, :id, :patient_name, params[:request_id]), { include_blank: 'All requests' }, class: 'w-full px-3 py-2 border rounded-md' %>
        </div>
      </div>
      <div class="flex gap-2">
        <%= form.submit "Search", class: "px-6 py-3 btn-primary text-white font-semibold rounded-lg transition-all duration-200 transform will-change-transform hover:scale-105 hover:shadow-xl" %>
        <% if params[:search].present? %>
          <%= link_to "Clear", healthcare_donations_path, class: "px-6 py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg transition-colors" %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium text-gray-600">Showing manual donations</span>
      </div>
      <% if current_user&.role == 'admin' %>
        <div class="flex gap-3">
          <%= link_to manual_new_healthcare_donations_path, class: "inline-flex items-center px-4 py-2 bg-foundationprimarygreen text-white rounded-md" do %>
            <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
            <span>Create Manual Donation</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Donations Grid -->
  <div id="manual_donations" class="relative z-10">
    <% if @healthcare_donations.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @healthcare_donations.each do |donation| %>
          <div class="bg-white rounded-2xl shadow p-4 border border-gray-100">
            <div class="flex items-start gap-3">
              <div class="flex-1">
                <h3 class="font-semibold text-lg"><%= link_to donation.request_patient_name, healthcare_request_path(donation.healthcare_request), class: 'text-foundationprimarygreen hover:underline' %></h3>
                <div class="text-sm text-gray-500">Donor: <%= donation.donor_name %></div>
                <div class="text-sm text-gray-500 mt-1"><%= truncate(donation.healthcare_request.reason, length: 80) %></div>
              </div>
              <div class="text-right">
                <div class="text-2xl font-extrabold text-green-600">৳<%= number_with_delimiter(donation.amount) %></div>
                <div class="text-xs text-gray-500 mt-1"><%= donation.created_at.strftime('%b %d, %Y') %></div>
              </div>
            </div>
            <div class="mt-4 flex gap-2">
              <%= link_to 'View', healthcare_donation_path(donation), class: 'px-3 py-2 bg-foundationprimarygreen text-white rounded-md' %>
              <%= link_to 'Request', healthcare_request_path(donation.healthcare_request), class: 'px-3 py-2 border rounded-md text-gray-700' %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <%= paginate @healthcare_donations if defined?(paginate) %>
      </div>
    <% else %>
      <div class="text-center py-12 text-gray-500">
        No manual donations found.
      </div>
    <% end %>
  </div>
</div>
