<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-4xl mx-auto">
    <div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-lg overflow-hidden">
      <div class="px-6 py-6 bg-foundationprimarygreen/5 border-b border-foundationprimarygreen/10">
        <% if flash[:notice]&.include?("donation") %>
          <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-foundationprimarygreen/10 mb-4">
              <svg class="h-6 w-6 text-foundationprimarygreen" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center"><span class="text-forange">Welcome</span> to Our Community!</h1>
            <p class="text-lg text-gray-700 mt-2 text-center">Thank you for your generous donation. Please set up a secure password for your account. We've also sent your temporary password to your email.</p>
          </div>
        <% else %>
          <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">Edit <span class="text-forange">Profile</span></h1>
          <p class="mt-2 text-lg text-gray-700 text-center">Update your account information</p>
        <% end %>
      </div>

      <div class="p-6">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: main inputs -->
            <div class="lg:col-span-2 space-y-4">
              <div>
                <%= f.label :first_name, class: "block text-sm font-medium text-foundationprimarygreen" %>
                <div class="mt-1">
                  <%= f.text_field :first_name, autofocus: true, class: "block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:first_name].any?}" %>
                </div>
                <% if resource.errors[:first_name].any? %>
                  <p class="mt-1 text-sm text-red-600"><%= resource.errors[:first_name].first %></p>
                <% else %>
                  <p class="mt-1 text-sm text-gray-400">Given name shown across the site.</p>
                <% end %>
              </div>

              <div>
                <%= f.label :last_name, class: "block text-sm font-medium text-foundationprimarygreen" %>
                <div class="mt-1">
                  <%= f.text_field :last_name, class: "block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:last_name].any?}" %>
                </div>
                <% if resource.errors[:last_name].any? %>
                  <p class="mt-1 text-sm text-red-600"><%= resource.errors[:last_name].first %></p>
                <% else %>
                  <p class="mt-1 text-sm text-gray-400">Family name used for display and sorting.</p>
                <% end %>
              </div>

              <div>
                <%= f.label :email, class: "block text-sm font-medium text-foundationprimarygreen" %>
                <div class="mt-1">
                  <%= f.email_field :email, autocomplete: "email", class: "block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:email].any?}" %>
                </div>
                <% if resource.errors[:email].any? %>
                  <p class="mt-1 text-sm text-red-600"><%= resource.errors[:email].first %></p>
                <% else %>
                  <p class="mt-1 text-sm text-gray-400">Email is used for sign in and notifications.</p>
                <% end %>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <%= f.label :phone_number, class: "block text-sm font-medium text-foundationprimarygreen" %>
                  <div class="mt-1">
                    <%= f.telephone_field :phone_number, class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:phone_number].any?}" %>
                  </div>
                  <% if resource.errors[:phone_number].any? %>
                    <p class="mt-1 text-sm text-red-600"><%= resource.errors[:phone_number].first %></p>
                  <% else %>
                    <p class="mt-1 text-sm text-gray-400">Optional — used for SMS notifications.</p>
                  <% end %>
                </div>

                <div>
                  <%= f.label :address, class: "block text-sm font-medium text-foundationprimarygreen" %>
                  <div class="mt-1">
                    <%= f.text_area :address, rows: 2, class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:address].any?}" %>
                  </div>
                  <% if resource.errors[:address].any? %>
                    <p class="mt-1 text-sm text-red-600"><%= resource.errors[:address].first %></p>
                  <% else %>
                    <p class="mt-1 text-sm text-gray-400">Optional — appear on public profile if provided.</p>
                  <% end %>
                </div>
              </div>

              <% if flash[:notice]&.include?("donation") %>
                <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                  <h3 class="text-sm font-medium text-yellow-800 mb-2">Set Up Your Password</h3>
                  <p class="text-xs text-yellow-700 mb-3">Please create a secure password for your account. This will replace the temporary password we created for you.</p>

                  <div class="space-y-3">
                    <div>
                      <%= f.label :password, "New Password", class: "block text-sm font-medium text-gray-700" %>
                      <%= f.password_field :password, autocomplete: "new-password", placeholder: "Enter a secure password", class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:password].any?}" %>
                      <% if @minimum_password_length %>
                        <p class="text-xs text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
                      <% end %>
                    </div>

                    <div>
                      <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-700" %>
                      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your password", class: "block w-full rounded-md sm:text-sm px-3 py-2 border" %>
                    </div>

                    <div>
                      <%= f.label :current_password, "Current Password", class: "block text-sm font-medium text-gray-700" %>
                      <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Enter your temporary password", class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:current_password].any?}" %>
                      <p class="text-xs text-gray-500 mt-1">Use the temporary password that was created when you made your donation (also sent to your email)</p>
                    </div>
                  </div>
                </div>
              <% else %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div class="md:col-span-1">
                    <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
                    <%= f.password_field :password, autocomplete: "new-password", placeholder: "Leave blank if you don't want to change it", class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:password].any?}" %>
                    <% if @minimum_password_length %>
                      <p class="text-xs text-gray-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
                    <% end %>
                  </div>

                  <div class="md:col-span-1">
                    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
                    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:password_confirmation].any?}" %>
                  </div>

                  <div class="md:col-span-1">
                    <%= f.label :current_password, class: "block text-sm font-medium text-gray-700" %>
                    <%= f.password_field :current_password, autocomplete: "current-password", class: "block w-full rounded-md sm:text-sm px-3 py-2 border #{'border-red-400' if resource.errors[:current_password].any?}" %>
                    <p class="text-xs text-gray-500 mt-1">We need your current password to confirm your changes</p>
                  </div>
                </div>
              <% end %>

              <!-- Actions -->
              <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-3">
                <%= f.submit "Update Account", class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 rounded-md text-sm text-white font-medium shadow-md btn-primary" %>
                <% if flash[:notice]&.include?("donation") %>
                  <%= link_to "Skip for now", root_path, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
                <% else %>
                  <%= link_to "Back", :back, class: "w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10" %>
                <% end %>
              </div>
            </div>

            <!-- Right: account actions / info -->
            <div class="space-y-4">
              <div class="border border-dashed border-forange/20 rounded-md p-4 flex flex-col items-center text-center bg-forange/5">
                <p class="text-sm font-medium text-foundationprimarygreen">Account</p>
                <p class="text-xs text-forange mt-1">Manage account settings and cancellation</p>
              </div>

              <% unless flash[:notice]&.include?("donation") %>
                <div class="p-4 border border-foundationprimarygreen/10 rounded-md bg-foundationprimarygreen/3 text-sm text-gray-700 text-center">
                  <h3 class="font-medium text-foundationprimarygreen">Cancel Account</h3>
                  <p class="mt-1 text-xs text-gray-600">Permanently delete your account and all associated data.</p>
                  <div class="mt-3">
                    <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure? This action cannot be undone.", turbo_confirm: "Are you sure?" }, method: :delete, class: "w-full inline-flex justify-center items-center px-3 py-2 rounded-md text-sm text-white font-medium bg-red-500 hover:bg-red-700" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
