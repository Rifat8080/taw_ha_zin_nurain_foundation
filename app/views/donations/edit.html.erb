<% content_for :title, "Edit Donation" %>

<div class="container mx-auto px-8 py-10">
  <div class="max-w-md mx-auto">
    <div class="bg-white shadow-lg rounded-lg overflow-hidden">
      <div class="px-6 py-4 bg-gray-50 border-b">
        <h1 class="text-2xl font-bold text-gray-900">Edit Donation</h1>
      </div>

      <div class="px-6 py-4">
        <div class="bg-blue-50 border border-blue-200 rounded-md p-3 mb-4">
          <p class="text-sm text-blue-700">
            <strong>Current Donor:</strong> <%= @donation.user&.full_name %> (<%= @donation.user&.email %>)
          </p>
        </div>

        <%= render 'donation_form', donation: @donation, projects: @projects, submit_text: 'Update Donation', show_cancel: true %>
      </div>
    </div>
  </div>
</div>
