<%= form_with(model: donation, local: true, html: { class: 'donation-form space-y-6', id: 'donation_form', data: (local_assigns[:primary] ? { primary: true } : {}) }) do |form| %>
  <% if donation.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(donation.errors.count, "error") %> prevented this donation from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% donation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
  <div class="w-full">
        <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">
          Live <span class="text-forange">QR</span> Scanner
        </h1>
        <p class="mt-2 text-lg text-gray-700 text-center">Fast check-ins, meals, breaks, and re-entry — streamlined for the team.</p>
      </div>

  <div class="rounded-lg overflow-hidden shadow-lg">
    <div class="p-4 bg-foundationprimarygreen">
      <% form_title_val = local_assigns[:form_title] || donation.project&.name.presence || (donation.persisted? ? 'Edit Donation' : 'Donate') %>
      <% form_subtitle_val = local_assigns[:form_subtitle] || donation.project&.donation_subtitle.presence || '' %>
      <h3 class="text-3xl md:text-4xl font-bold text-white"><%= form_title_val %></h3>
      <% if form_subtitle_val.present? %>
        <p class="mt-1 text-lg text-white/90"><%= form_subtitle_val %></p>
      <% end %>
    </div>

    <div class="p-6 bg-white">
      <div class="flex items-baseline justify-between">
        <div>
          <p class="text-sm text-gray-500">Raised so far</p>
          <% raised = donation.project ? donation.project.donations.sum(:amount) : (defined?(@total_donations) ? @total_donations : 0) %>
          <p class="text-2xl font-extrabold text-gray-900"><%= number_to_currency(raised || 0) %></p>
        </div>
      </div>

      <% if donation.project %>
        <% donations_total = donation.project.donations.sum(:amount) rescue 0 %>
        <% expenses_total = donation.project.respond_to?(:expenses) ? donation.project.expenses.sum(:amount) : 0 rescue 0 %>
        <% net_balance = donations_total - expenses_total %>
        <div class="mt-4 bg-gray-50 border border-gray-100 rounded-md p-3 sm:p-4">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
            <div>
              <span class="text-xs text-gray-500">Donations</span>
              <div class="text-lg font-semibold text-foundationprimarygreen"><%= number_to_currency(donations_total || 0) %></div>
            </div>
            <div>
              <span class="text-xs text-gray-500">Expenses</span>
              <div class="text-lg font-semibold text-red-600"><%= number_to_currency(expenses_total || 0) %></div>
            </div>
            <div class="text-right">
              <span class="text-xs text-gray-500">Net balance</span>
              <div class="text-lg font-semibold <%= net_balance >= 0 ? 'text-foundationprimarygreen' : 'text-red-600' %>"><%= number_to_currency(net_balance || 0) %></div>
            </div>
          </div>
          <div class="mt-3 text-xs text-gray-500">
            <span>Last updated: <%= (donation.project&.updated_at || Time.current).to_date %></span>
            <span class="mx-2">•</span>
            <% if current_user&.role == 'admin' && donation.project %>
              <%= link_to 'View full accounting', admin_reports_path(project_id: donation.project.id), class: 'text-sm text-forange hover:underline' %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Preset amounts -->
      <div class="mt-5">
        <div class="grid grid-cols-3 gap-2 sm:gap-3">
          <% [50, 150, 250, 500].each do |amt| %>
            <button type="button" data-amount="<%= amt %>" role="button" tabindex="0" aria-pressed="false" class="preset-amount border rounded-md py-2 sm:py-3 text-sm font-medium text-gray-700 hover:bg-forange/10 px-2 sm:px-3">$<span class="font-semibold"><%= amt %></span></button>
          <% end %>
        </div>
      </div>

      <!-- Amount input and hidden payloads -->
      <div class="mt-4">
        <div class="space-y-3">
          <% if donation.project.present? %>
            <%= form.hidden_field :project_id, value: donation.project.id %>
          <% else %>
            <% if defined?(projects) && projects.present? %>
              <div>
                <%= form.label :project_id, "Project", class: 'block text-sm font-medium text-gray-700' %>
                <div class="mt-1">
                  <%= form.select :project_id, options_from_collection_for_select(projects, :id, :name, donation.project_id), { include_blank: 'Select a project to support' }, class: 'w-full rounded-md border px-3 py-2', required: true %>
                </div>
              </div>
            <% else %>
              <%= form.hidden_field :project_id, value: nil %>
            <% end %>
          <% end %>

          <div>
            <label for="donation_amount" class="sr-only">Amount</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-600">$</span>
              <%= form.number_field :amount, id: 'donation_amount', name: 'donation[amount]', placeholder: 'Other amount', min: 1, step: 1, required: true, value: (donation.amount.presence || ''), class: 'w-full rounded-md border px-3 py-2 pl-8' %>
            </div>
          </div>

          <%= hidden_field_tag 'donation[primary_amount]', nil, id: 'donation_primary_amount' %>
          <%= hidden_field_tag 'donation[extras_json]', nil, id: 'donation_extras_json' %>
          <div class="text-sm text-gray-600">Total: $<span id="donation_total_value"><%= number_with_precision(0, precision: 0) %></span></div>
        </div>
      </div>

      <!-- Donor / email -->
      <div class="mt-4">
        <% if user_signed_in? %>
          <div class="py-2 px-3 bg-gray-50 rounded-md text-sm text-gray-700">
            <div class="font-medium"><%= current_user.first_name %> <%= current_user.last_name %></div>
            <div class="text-xs text-gray-500"><%= current_user.email %></div>
          </div>
        <% else %>
          <div>
            <%= form.email_field :email, id: 'donation_email', placeholder: 'Email (required if not signed in)', class: 'w-full rounded-md border px-3 py-2' %>
          </div>
        <% end %>
      </div>

      <!-- Payment method -->
      <div class="mt-4">
        <p class="text-sm font-medium text-gray-700">Payment method</p>
        <div class="mt-2 flex gap-3 items-center">
          <label class="inline-flex items-center gap-2">
            <%= form.radio_button :payment_method, 'online', checked: true, class: 'payment-method-radio accent-forange' %>
            <span class="text-sm text-forange">Online payment</span>
          </label>
          <label class="inline-flex items-center gap-2">
            <%= form.radio_button :payment_method, 'manual_transaction', class: 'payment-method-radio accent-forange' %>
            <span class="text-sm text-forange">Manual (transaction id)</span>
          </label>
          <% if user_signed_in? && current_user.role == 'admin' %>
            <label class="inline-flex items-center gap-2">
              <%= form.radio_button :payment_method, 'manual_cash', class: 'payment-method-radio accent-forange' %>
              <span class="text-sm text-forange">Cash (manual - admin)</span>
            </label>
          <% end %>
        </div>

        <div id="transaction_wrap" class="hidden mt-2">
          <%= form.text_field :transaction_id, id: 'donation_transaction_id', placeholder: 'Transaction ID (if applicable)', class: 'w-full rounded-md border px-3 py-2' %>
        </div>

        <%= form.hidden_field :manual, value: false, id: 'donation_manual_flag' %>
      </div>

      <div class="mt-4">
        <%= form.submit (donation.persisted? ? 'Update Donation' : 'DONATE NOW'), class: 'w-full btn-donate px-4 py-3 font-semibold rounded-md text-white' %>
      </div>

      <p class="mt-3 text-xs text-gray-500">Your donation will help deliver food, shelter and medicine where it’s most needed.</p>
    </div>
  </div>

<% end %>
