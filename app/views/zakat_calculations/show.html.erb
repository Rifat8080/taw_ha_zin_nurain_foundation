<% content_for :title, "Zakat Calculation #{ @zakat_calculation.calculation_year }" %>
<div class="container mx-auto px-8 py-8">
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-8 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">
        Zakat Calculation <span class="text-forange"><%= @zakat_calculation.calculation_year %></span>
      </h1>
      <p class="mt-2 text-lg text-gray-700 text-center">Summary of assets, liabilities and computed zakat.</p>
    </div>
    <div class="mt-4 md:mt-0 flex items-center gap-3">
      <%= link_to edit_zakat_calculation_path(@zakat_calculation), class: "px-4 py-2 bg-white border rounded hover:bg-forange/10" do %>
        Edit
      <% end %>
      <%= link_to zakat_calculations_path, class: "px-4 py-2 bg-gray-100 rounded hover:bg-forange/10" do %>
        Back
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-blue-900">Net Assets</h3>
      <p class="text-2xl font-bold text-blue-900 mt-2"><%= @zakat_calculation.formatted_net_assets %></p>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-yellow-800">Nisab Threshold</h3>
      <p class="text-2xl font-bold text-yellow-900 mt-2"><%= @zakat_calculation.formatted_nisab_value %></p>
    </div>

    <div class="bg-green-50 border border-green-200 rounded-lg p-6">
      <h3 class="text-lg font-semibold text-green-900">Zakat Due</h3>
      <p class="text-2xl font-bold text-green-900 mt-2"><%= @zakat_calculation.formatted_zakat_due %></p>
      <div class="mt-2"><span class="text-sm <%= @zakat_calculation.zakat_eligible? ? 'text-green-700' : 'text-gray-600' %>"><%= @zakat_calculation.zakat_eligible? ? 'Eligible' : 'Below Nisab' %></span></div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Assets</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @zakat_calculation.assets.each do |asset| %>
        <div class="border rounded p-3">
          <div class="flex justify-between items-start">
            <div>
              <div class="text-sm text-gray-600"><%= asset.category.humanize %></div>
              <div class="font-medium text-gray-900"><%= number_with_delimiter(asset.amount) %></div>
            </div>
          </div>
          <div class="mt-2 text-xs text-gray-600"><%= asset.description %></div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-6 bg-white rounded-lg shadow border border-gray-200 p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Liabilities</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @zakat_calculation.liabilities.each do |liab| %>
        <div class="border rounded p-3">
          <div class="flex justify-between items-start">
            <div>
              <div class="text-sm text-gray-600"><%= liab.description %></div>
              <div class="font-medium text-gray-900"><%= number_with_delimiter(liab.amount) %></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
