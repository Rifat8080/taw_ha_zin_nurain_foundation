<div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-sm p-4 flex flex-col justify-between">
  <div>
    <div class="flex items-center gap-3">
      <% initials = if volunteer.respond_to?(:initials) && volunteer.initials.present?
                     volunteer.initials
                   else
                     volunteer.full_name.to_s.split.map { |n| n[0] }.join.upcase[0..1]
                   end %>
      <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-lg font-semibold text-gray-700">
        <%= initials.presence || "—" %>
      </div>
      <div>
        <div class="text-lg font-medium text-gray-900"><%= volunteer.full_name %></div>
        <div class="text-sm text-gray-500"><%= volunteer.email %></div>
        <div class="text-sm mt-1"><%= volunteer.phone_number %></div>
      </div>
    </div>

    <div class="mt-3">
      <%= volunteer_role_badge(volunteer.role) %>
      <span class="text-sm text-gray-500 ml-2">Joined <%= volunteer.joining_date.strftime('%b %d, %Y') %></span>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <div>
      <%= link_to 'View', volunteer_path(volunteer), class: 'text-sm text-foundationprimarygreen hover:underline' %>
    </div>
    
    <div class="flex gap-2">
      <% if current_user&.role == 'admin' %>
        <%= link_to 'Edit', edit_volunteer_path(volunteer), class: 'inline-flex items-center px-3 py-1 btn-primary text-white rounded-md text-sm' %>
        <%= link_to 'Assign', new_team_assignment_path(volunteer_id: volunteer.id), class: 'inline-flex items-center px-3 py-1 border rounded-md text-sm bg-white text-gray-700 hover:bg-forange/10' %>
      <% end %>
    </div>
  </div>
</div>
