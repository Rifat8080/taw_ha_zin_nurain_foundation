<%= form_with(model: volunteer, local: true, class: "space-y-6") do |form| %>

  <% if volunteer.errors.any? %>
    <div id="error_explanation" class="rounded-md bg-red-50 border border-red-100 p-4">
      <div class="flex items-start gap-3">
        <svg class="h-5 w-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M8.257 3.099c.366-.446.957-.596 1.5-.34l.094.05 6.5 3.75A1 1 0 0117 7.5v6a1 1 0 01-.553.894l-.094.05-6.5 3.75a1 1 0 01-1.5-.34L3 15.5V4.5a1 1 0 01.257-.701l.0-.0 5-.7z" clip-rule="evenodd"></path></svg>
        <div>
          <p class="text-sm font-semibold text-red-700"><%= pluralize(volunteer.errors.count, "error") %> prevented this volunteer from being saved</p>
          <ul class="mt-2 text-sm text-red-600 list-disc ml-5">
            <% volunteer.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>
  

  <div class="bg-white border border-foundationprimarygreen/10 rounded-lg shadow-lg p-6">
  <div class="flex justify-between items-center">
    <div class="mb-4">
      <h2 class="text-3xl font-bold">
        <span class="text-foundationprimarygreen"><%= volunteer.persisted? ? "Edit" : "Create" %></span>
        <span class="text-forange"> Volunteer</span>
      </h2>
    </div>
     <div class="flex gap-2">
      <%= link_to 'View All Volunteers', volunteers_path, class: 'bg-forange hover:bg-forange/90 text-white font-bold py-2 px-4 rounded' %>
      <%= link_to 'All Users', users_path, class: 'bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
    </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-4">
        <div>
          <label class="block text-sm font-medium text-foundationprimarygreen">User</label>
          <% if volunteer.persisted? && volunteer.user.present? %>
            <div class="mt-3 bg-white border rounded-md p-3">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-lg font-semibold text-gray-700">
                  <% initials = [volunteer.user.first_name, volunteer.user.last_name].compact.map { |n| n[0] }.join.upcase[0..1] %>
                  <%= initials.presence || '—' %>
                </div>
                <div>
                  <div class="text-md font-medium text-gray-900"><%= volunteer.user.full_name %></div>
                  <div class="text-sm text-gray-600"><%= volunteer.user.email %></div>
                  <div class="text-sm text-gray-600"><%= volunteer.user.phone_number %></div>
                </div>
              </div>
              <div class="mt-3">
                <%= link_to 'View user', user_path(volunteer.user), class: 'text-sm text-foundationprimarygreen hover:underline' %>
              </div>
              <%= form.hidden_field :user_id, id: 'volunteer_user_id', value: volunteer.user_id %>
            </div>
          <% else %>
            <div class="mt-2 flex gap-3 items-start">
              <label class="inline-flex items-center">
                <input type="radio" name="volunteer_user_mode" value="existing" checked class="mr-2" />
                <span class="text-sm">Select existing user</span>
              </label>
              <label class="inline-flex items-center">
                <input type="radio" name="volunteer_user_mode" value="create" class="mr-2" />
                <span class="text-sm">Create new user</span>
              </label>
            </div>

            <!-- Existing user select + live search -->
            <div id="existing-user-section" class="mt-3">
              <input id="live_user_search" type="search" placeholder="Search registered users by name or email..." class="w-full px-3 py-2 border rounded-md" autocomplete="off" />
              <div id="live_user_results" class="mt-2"></div>
              <div id="selected_user_display" class="mt-2"></div>
              <%= form.hidden_field :user_id, id: 'volunteer_user_id', value: volunteer.user_id %>
            </div>

            <!-- Inline new user creation - hidden by default -->
            <div id="new-user-section" class="mt-3 hidden">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <%= form.label :first_name, 'First name', class: 'block text-sm font-medium text-gray-700' %>
                  <%= text_field_tag 'user[first_name]', nil, class: 'mt-1 block w-full px-3 py-2 border rounded-md' %>
                </div>
                <div>
                  <%= form.label :last_name, 'Last name', class: 'block text-sm font-medium text-gray-700' %>
                  <%= text_field_tag 'user[last_name]', nil, class: 'mt-1 block w-full px-3 py-2 border rounded-md' %>
                </div>
                <div>
                  <%= form.label :email, 'Email', class: 'block text-sm font-medium text-gray-700' %>
                  <%= email_field_tag 'user[email]', nil, class: 'mt-1 block w-full px-3 py-2 border rounded-md' %>
                </div>
                <div>
                  <%= form.label :phone_number, 'Phone', class: 'block text-sm font-medium text-gray-700' %>
                  <%= telephone_field_tag 'user[phone_number]', nil, class: 'mt-1 block w-full px-3 py-2 border rounded-md' %>
                </div>
                <div class="sm:col-span-2">
                  <%= form.label :address, 'Address', class: 'block text-sm font-medium text-gray-700' %>
                  <%= text_field_tag 'user[address]', nil, class: 'mt-1 block w-full px-3 py-2 border rounded-md' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div>
          <%= form.label :joining_date, 'Joining Date', class: 'block text-sm font-medium text-foundationprimarygreen' %>
          <div class="mt-1">
            <%= form.date_field :joining_date, class: 'block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border' %>
          </div>
        </div>

        <div>
          <%= form.label :role, 'Volunteer Role', class: 'block text-sm font-medium text-foundationprimarygreen' %>
          <div class="mt-1">
            <%= form.select :role, volunteer_role_options, { prompt: 'Select a role' }, class: 'block w-full rounded-md shadow-sm sm:text-sm px-3 py-2 border' %>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <div class="bg-foundationprimarygreen/5 border border-foundationprimarygreen/10 rounded-lg p-4">
          <div class="text-sm font-medium text-foundationprimarygreen">Help</div>
          <div class="mt-2 text-sm text-gray-600">
            Choose an existing user to promote to volunteer, or create a new user inline and they will be associated with this volunteer record.
          </div>
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-3">
      <%= link_to 'Cancel', volunteer.persisted? ? volunteer_path(volunteer) : volunteers_path, class: 'w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 border border-forange/30 rounded-md bg-white text-sm text-foundationprimarygreen hover:bg-forange/10' %>
      <%= form.submit volunteer.persisted? ? 'Update Volunteer' : 'Create Volunteer', class: 'w-full sm:w-auto inline-flex justify-center items-center px-4 py-2 rounded-md text-sm text-white font-medium shadow-md btn-primary' %>
    </div>
  </div>
<% end %>
