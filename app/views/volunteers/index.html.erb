<% content_for :title, "Volunteers" %>
<div class="container mx-auto px-8 py-8">
  <div class="flex flex-col md:flex-row justify-between items-center text-center mb-8 gap-4">
    <div class="w-full">
      <h1 class="text-4xl md:text-5xl font-bold text-foundationprimarygreen tracking-tight text-center">Our <span class="text-forange">Volunteers</span></h1>
      <p class="mt-2 text-lg text-gray-700 text-center">Manage volunteers, their roles and team assignments</p>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="mb-8 bg-white rounded-lg shadow border border-foundationprimarygreen/20 p-6">
    <%= form_with url: volunteers_path, method: :get, local: true, class: "flex flex-col md:flex-row gap-4" do |form| %>
      <div class="flex-1">
        <%= form.text_field :search, placeholder: "Search volunteers by name, email or phone...", value: params[:search], class: "w-full px-4 py-3 border border-foundationprimarygreen/30 rounded-lg focus:ring-2 focus:ring-forange focus:border-forange text-gray-900 placeholder-gray-500" %>
      </div>
      <div class="flex items-center gap-2">
        <%= form.select :role, options_for_select([['All Roles', '']] + volunteer_role_options, params[:role]), {}, class: "px-3 py-2 border border-foundationprimarygreen/30 rounded-lg" %>
        <%= form.submit "Search", class: "px-6 py-3 btn-primary text-white font-semibold rounded-lg transition-all duration-200 transform will-change-transform hover:scale-105 hover:shadow-xl" %>
        <% if params[:search].present? || params[:role].present? %>
          <%= link_to "Clear", volunteers_path, class: "px-6 py-3 bg-gray-200 hover:bg-forange hover:text-white text-gray-700 font-semibold rounded-lg transition-colors" %>
        <% end %>
      </div>
    <% end %>
    <div class="mt-4 flex items-center justify-between">
      <div class="flex flex-wrap gap-2">
        <span class="text-sm font-medium text-gray-600 mr-2">Popular roles:</span>
        <% volunteer_role_options.each do |role| %>
          <%= link_to volunteers_path(role: role[1]), class: "inline-flex items-center px-3 py-1 rounded-full text-sm #{ params[:role] == role[1] ? 'bg-forange/10 text-forange border border-forange' : 'bg-gray-100 text-gray-700 hover:bg-forange/10 hover:text-forange border border-transparent'} transition-colors" do %>
            <%= role[0] %>
          <% end %>
        <% end %>
      </div>
      <div class="text-sm text-gray-600">Total: <%= @volunteers.count %> volunteers</div>
    </div>
  </div>

  <% if current_user&.role == "admin" %>
    <div class="flex gap-3 mb-6 w-full md:w-auto">
      <%= link_to new_volunteer_path, class: "w-full md:w-auto inline-flex items-center whitespace-nowrap px-6 py-3 btn-primary text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
        <i class="fa-solid fa-plus mr-2" aria-hidden="true"></i>
        New Volunteer
      <% end %>
      <%= link_to team_assignments_path, class: "inline-flex items-center px-6 py-3 bg-white border border-foundationprimarygreen/20 text-foundationprimarygreen rounded-lg hover:bg-forange/10" do %>
        Team Assignments
      <% end %>
    </div>
  <% end %>

  <% if @volunteers.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @volunteers.each do |volunteer| %>
        <%= render 'volunteer_card', volunteer: volunteer %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-8">
      <p class="text-gray-500">No volunteers found.</p>
    </div>
  <% end %>
</div>
